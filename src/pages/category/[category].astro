---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { isPostPublic, listPosts } from '../../lib/posts';
import { getRuntimeEnv } from '../../lib/runtime-env';
import { readSettings } from '../../lib/settings';
import { getTemplateFile } from '../../lib/template-files';
import { renderTemplateVariables } from '../../lib/template-vars';

const category = decodeURIComponent(Astro.params.category!);
const runtimeEnv = getRuntimeEnv(Astro.locals);
const settings = await readSettings(runtimeEnv);
const categoryFile = await getTemplateFile('category', runtimeEnv);
const categoryConfig = (settings.categories || []).find((item) => item.slug.toLowerCase() === category.toLowerCase());
const categoryTitle = categoryConfig?.seoTitle || `${categoryConfig?.name || category} - ${settings.title}`;
const categoryDesc = categoryConfig?.seoDescription || categoryConfig?.description || `Posts in ${category}`;
const template = categoryConfig?.template || 'classic';
const modules = categoryConfig?.modules?.length ? categoryConfig.modules : ['hero', 'list', 'sidebar'];
const posts = (await listPosts(runtimeEnv))
  .filter((post) => isPostPublic(post) && (post.category || '').toLowerCase() === category.toLowerCase())
  .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());
const categoryHero = renderTemplateVariables(categoryFile?.content || '', {
  'site.title': settings.title,
  'category.slug': categoryConfig?.slug || category,
  'category.name': categoryConfig?.name || category,
  'category.description': categoryConfig?.description || '',
  'category.count': String(posts.length),
  ...settings.templateVariables,
});
---

<SiteLayout title={categoryTitle} description={categoryDesc}>
  {categoryConfig?.adTop && <section class="mb-4 rounded-2xl border border-slate-200 bg-white p-4" set:html={categoryConfig.adTop} />}
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_280px]">
    <div>
      {modules.includes('hero') && (
        <>
          {categoryHero && <div class="mb-4" set:html={categoryHero} />}
          <section class="mb-8">
            <h1 class="text-3xl font-black tracking-tight text-slate-950">{categoryConfig?.name || category}</h1>
            {categoryConfig?.description && <p class="mt-2 text-sm text-slate-600">{categoryConfig.description}</p>}
            <p class="mt-2 text-sm text-slate-500">{posts.length} posts</p>
          </section>
        </>
      )}
      {modules.includes('list') && (
        <div class:list={["grid gap-4", template === 'grid' ? 'md:grid-cols-2 lg:grid-cols-3' : template === 'minimal' ? 'md:grid-cols-1' : 'md:grid-cols-2']}>
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class:list={["rounded-[1.5rem] border border-slate-200 bg-white transition hover:-translate-y-1 hover:shadow-xl", template === 'minimal' ? 'p-4' : 'p-5']}>
              {template !== 'minimal' && post.coverImage && <img class="mb-3 h-40 w-full rounded-xl object-cover" src={post.coverImage} alt={post.title} />}
              <h2 class="text-lg font-semibold text-slate-950">{post.title}</h2>
              <p class="mt-2 text-slate-600">{post.description}</p>
            </a>
          ))}
        </div>
      )}
    </div>
    {modules.includes('sidebar') && (
      <aside class="space-y-4">
        <section class="rounded-2xl border border-slate-200 bg-white p-4">
          <div class="text-sm font-semibold text-slate-800">Category Info</div>
          <p class="mt-2 text-sm text-slate-600">{categoryConfig?.description || 'No description'}</p>
          <p class="mt-2 text-xs text-slate-500">Posts: {posts.length}</p>
        </section>
        {categoryConfig?.adSidebar && <section class="rounded-2xl border border-slate-200 bg-white p-4" set:html={categoryConfig.adSidebar} />}
      </aside>
    )}
  </div>
</SiteLayout>
