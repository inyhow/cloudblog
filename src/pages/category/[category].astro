---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { listPosts } from '../../lib/posts';
import { getRuntimeEnv } from '../../lib/runtime-env';

const category = decodeURIComponent(Astro.params.category!);
const runtimeEnv = getRuntimeEnv(Astro.locals);
const posts = (await listPosts(runtimeEnv))
  .filter((post) => post.status === 'published' && (post.category || '').toLowerCase() === category.toLowerCase())
  .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());
---

<SiteLayout title={`Category: ${category}`} description={`Posts in ${category}`}>
  <section class="mb-8">
    <h1 class="text-3xl font-black tracking-tight text-slate-950">Category: {category}</h1>
    <p class="mt-2 text-sm text-slate-500">{posts.length} posts</p>
  </section>
  <div class="grid gap-4 md:grid-cols-2">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}`} class="rounded-[1.5rem] border border-slate-200 bg-white p-5 transition hover:-translate-y-1 hover:shadow-xl">
        <h2 class="text-lg font-semibold text-slate-950">{post.title}</h2>
        <p class="mt-2 text-slate-600">{post.description}</p>
      </a>
    ))}
  </div>
</SiteLayout>
