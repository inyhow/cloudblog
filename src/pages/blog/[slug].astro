---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPostBySlug, markdownToHtml } from '../../lib/posts';
import { readSettings } from '../../lib/settings';
import { getRuntimeEnv } from '../../lib/runtime-env';
import { getTemplateFile } from '../../lib/template-files';

const slug = Astro.params.slug!;
const runtimeEnv = getRuntimeEnv(Astro.locals);
const post = await getPostBySlug(slug, runtimeEnv);
if (!post || post.status !== 'published') {
  return Astro.redirect('/blog');
}

const settings = await readSettings(runtimeEnv);
const postTemplate = settings.templates?.post ?? 'classic';
const postFile = await getTemplateFile('post', runtimeEnv);
const postHeaderHtml = postFile?.content || settings.templateContent?.postHeaderHtml || '';
const html = markdownToHtml(post.content);
---

<SiteLayout title={post.title} description={post.description}>
  {postHeaderHtml && <div class="mb-4" set:html={postHeaderHtml} />}
  <article class:list={["prose max-w-none rounded-[2rem] border border-slate-200 bg-white shadow-sm", postTemplate === 'minimal' ? 'p-5' : 'p-7']}>
    {post.coverImage && (
      <img
        class:list={["mb-6 w-full rounded-[1.5rem] object-cover", postTemplate === 'cover' ? 'h-[32rem]' : 'h-80']}
        src={post.coverImage}
        alt={post.title}
      />
    )}
    <div class="mb-5 flex flex-wrap items-center gap-3 text-sm text-slate-500">
      <span>{new Date(post.pubDate).toLocaleString('zh-CN')}</span>
      {post.updatedDate && <span>Updated {new Date(post.updatedDate).toLocaleString('zh-CN')}</span>}
      {post.pinned && <span class="rounded-full bg-amber-100 px-2 py-1 text-xs text-amber-700">Pinned</span>}
    </div>
    <h1>{post.title}</h1>
    <div set:html={html} />
  </article>
  <div class="mt-5 flex flex-wrap gap-2">
    {post.tags.map((tag) => (
      <a class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-600" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>
    ))}
  </div>
  {
    settings.giscus && (
      <section class="mt-8">
        <script
          src="https://giscus.app/client.js"
          data-repo={settings.giscus.repo}
          data-repo-id={settings.giscus.repoId}
          data-category={settings.giscus.category}
          data-category-id={settings.giscus.categoryId}
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="preferred_color_scheme"
          crossOrigin="anonymous"
          async
        />
      </section>
    )
  }
</SiteLayout>
