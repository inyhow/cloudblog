---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { isPostPublic, listPosts } from '../../lib/posts';
import { getRuntimeEnv } from '../../lib/runtime-env';
import { readSettings } from '../../lib/settings';

const runtimeEnv = getRuntimeEnv(Astro.locals);
const settings = await readSettings(runtimeEnv);
const listTemplate = settings.templates?.tag ?? 'classic';
const isImoo = listTemplate === 'imoo';
const posts = (await listPosts(runtimeEnv))
  .filter((post) => isPostPublic(post))
  .sort((a, b) => {
    if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;
    return new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf();
  });
---

<SiteLayout title="Blog" description={settings.description} variant={isImoo ? 'imoo' : 'classic'}>
  <section class:list={[
    'mb-8 flex items-end justify-between gap-4',
    isImoo ? 'rounded-[2rem] border border-white/10 bg-white px-6 py-6 shadow-xl shadow-slate-900/5' : '',
  ]}>
    <div>
      <p class:list={[
        'mb-2 text-xs uppercase tracking-[0.24em]',
        isImoo ? 'text-amber-600' : 'text-slate-400',
      ]}>Archive</p>
      <h1 class:list={[
        'font-black tracking-tight',
        isImoo ? 'text-4xl text-slate-950' : 'text-3xl text-slate-950',
      ]}>All Posts</h1>
    </div>
    <p class="text-sm text-slate-500">{posts.length} published articles</p>
  </section>
  <div class:list={[
    'grid gap-4',
    listTemplate === 'grid' ? 'md:grid-cols-2' : 'md:grid-cols-3',
    listTemplate === 'minimal' ? 'gap-3 md:grid-cols-1' : '',
    isImoo ? 'xl:grid-cols-4 md:grid-cols-2' : '',
  ]}>
    {posts.map((post) => (
      <a
        href={`/blog/${post.slug}`}
        class:list={[
          'rounded-[1.5rem] border bg-white transition hover:-translate-y-1 hover:shadow-xl',
          listTemplate === 'minimal' ? 'p-4' : 'overflow-hidden',
          isImoo ? 'border-slate-200 shadow-[0_16px_50px_-30px_rgba(15,23,42,0.35)]' : 'border-slate-200',
        ]}
      >
        {listTemplate !== 'minimal' && post.coverImage && <img class="h-48 w-full object-cover" src={post.coverImage} alt={post.title} />}
        <div class:list={[listTemplate === 'minimal' ? '' : 'p-5']}>
          <div class="mb-3 flex items-center gap-2 text-xs uppercase tracking-[0.22em] text-slate-400">
            {post.pinned && <span class="rounded-full bg-amber-100 px-2 py-1 text-amber-700">Pinned</span>}
            <span>{new Date(post.pubDate).toLocaleDateString('zh-CN')}</span>
          </div>
          <h2 class="text-lg font-semibold text-slate-950">{post.title}</h2>
          <p class="mt-2 text-slate-600">{post.description}</p>
          {post.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-500">
              {post.tags.map((tag) => (
                <a href={`/tags/${encodeURIComponent(tag)}`} class="rounded-full bg-slate-100 px-3 py-1 hover:bg-slate-200">#{tag}</a>
              ))}
            </div>
          )}
        </div>
      </a>
    ))}
  </div>
</SiteLayout>
