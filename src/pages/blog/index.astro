---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { listPosts } from '../../lib/posts';

const posts = await listPosts();
---

<SiteLayout title="博客列表">
  <h1 class="mb-6 text-2xl font-bold">博客列表</h1>
  <div class="grid gap-4">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}`} class="rounded-lg border border-slate-200 bg-white p-4 transition hover:shadow">
        <h2 class="text-lg font-semibold">{post.title}</h2>
        <p class="mt-2 text-slate-600">{post.description}</p>
      </a>
    ))}
  </div>
</SiteLayout>
