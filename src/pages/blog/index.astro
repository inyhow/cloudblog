---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { listPosts } from '../../lib/posts';
import { getRuntimeEnv } from '../../lib/runtime-env';
import { readSettings } from '../../lib/settings';

const runtimeEnv = getRuntimeEnv(Astro.locals);
const settings = await readSettings(runtimeEnv);
const tagTemplate = settings.templates?.tag ?? 'classic';
const posts = (await listPosts(runtimeEnv))
  .filter((post) => post.status === 'published')
  .sort((a, b) => {
    if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;
    return new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf();
  });
---

<SiteLayout title="博客列表">
  <h1 class="mb-6 text-2xl font-bold">博客列表</h1>
  <div class:list={["grid gap-4", tagTemplate === 'grid' ? 'md:grid-cols-2' : '', tagTemplate === 'minimal' ? 'gap-2' : '']}>
    {posts.map((post) => (
      <a href={`/blog/${post.slug}`} class:list={["rounded-lg border border-slate-200 bg-white transition hover:shadow", tagTemplate === 'minimal' ? 'p-3' : 'p-4']}>
        {post.coverImage && <img class="mb-3 h-44 w-full rounded object-cover" src={post.coverImage} alt={post.title} />}
        <div class="mb-2 flex items-center gap-2">
          {post.pinned && <span class="rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-700">置顶</span>}
          <h2 class="text-lg font-semibold">{post.title}</h2>
        </div>
        <p class="mt-2 text-slate-600">{post.description}</p>
        <p class="mt-2 text-xs text-slate-500">发布时间：{new Date(post.pubDate).toLocaleString('zh-CN')}</p>
      </a>
    ))}
  </div>
</SiteLayout>
