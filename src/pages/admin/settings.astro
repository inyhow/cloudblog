---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Settings">
  <div class="mb-6">
    <h1 class="text-3xl font-semibold text-white">Site Settings</h1>
    <p class="mt-2 text-sm text-slate-300">Manage global config, template presets, HTML fragments, and theme CSS.</p>
  </div>

  <form id="settings-form" class="grid gap-6">
    <section class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
      <h2 class="mb-4 text-lg font-semibold text-amber-300">Base</h2>
      <div class="grid gap-3">
        <input class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="title" placeholder="SEO title" />
        <input class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="description" placeholder="SEO description" />
        <textarea class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="menu" placeholder='Menu JSON'></textarea>
        <textarea class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="footer" placeholder="Footer text"></textarea>
        <textarea class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="analyticsJs" placeholder="Analytics JS"></textarea>
      </div>
    </section>

    <section class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
      <h2 class="mb-4 text-lg font-semibold text-amber-300">Template Presets</h2>
      <div class="grid gap-3 md:grid-cols-2">
        <label class="grid gap-1">
          <span class="text-sm text-slate-300">Home</span>
          <select class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="homeTemplate">
            <option value="classic">classic</option>
            <option value="magazine">magazine</option>
            <option value="minimal">minimal</option>
          </select>
        </label>
        <label class="grid gap-1">
          <span class="text-sm text-slate-300">Post</span>
          <select class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="postTemplate">
            <option value="classic">classic</option>
            <option value="cover">cover</option>
            <option value="minimal">minimal</option>
          </select>
        </label>
        <label class="grid gap-1">
          <span class="text-sm text-slate-300">Tag</span>
          <select class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="tagTemplate">
            <option value="classic">classic</option>
            <option value="grid">grid</option>
            <option value="minimal">minimal</option>
          </select>
        </label>
        <label class="grid gap-1">
          <span class="text-sm text-slate-300">Page</span>
          <select class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="pageTemplate">
            <option value="classic">classic</option>
            <option value="minimal">minimal</option>
          </select>
        </label>
      </div>
    </section>

    <section class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
      <h2 class="mb-4 text-lg font-semibold text-amber-300">Template Fragments</h2>
      <div class="grid gap-4">
        <textarea class="min-h-28 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="homeHeroHtml" placeholder="Home hero HTML"></textarea>
        <textarea class="min-h-24 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="postHeaderHtml" placeholder="Post header HTML"></textarea>
        <textarea class="min-h-24 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="tagHeaderHtml" placeholder="Tag header HTML"></textarea>
        <textarea class="min-h-24 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="pageHeaderHtml" placeholder="Page header HTML"></textarea>
      </div>
    </section>

    <section class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
      <h2 class="mb-4 text-lg font-semibold text-amber-300">Theme CSS</h2>
      <textarea class="min-h-64 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="css" id="css"></textarea>
    </section>

    <div class="flex gap-3">
      <button class="rounded-xl bg-amber-400 px-4 py-2 font-medium text-slate-950" type="submit">Save Settings</button>
      <a class="rounded-xl border border-white/10 px-4 py-2 text-slate-200" href="/admin/posts">Back</a>
    </div>
  </form>

  <p id="msg" class="mt-4 text-sm text-slate-300"></p>

  <script is:inline>
    (() => {
      const form = document.getElementById('settings-form');
      const msg = document.getElementById('msg');
      const cssInput = document.getElementById('css');

      const fields = {
        title: form.querySelector('input[name="title"]'),
        description: form.querySelector('input[name="description"]'),
        menu: form.querySelector('textarea[name="menu"]'),
        footer: form.querySelector('textarea[name="footer"]'),
        analyticsJs: form.querySelector('textarea[name="analyticsJs"]'),
        homeTemplate: form.querySelector('select[name="homeTemplate"]'),
        postTemplate: form.querySelector('select[name="postTemplate"]'),
        tagTemplate: form.querySelector('select[name="tagTemplate"]'),
        pageTemplate: form.querySelector('select[name="pageTemplate"]'),
        homeHeroHtml: form.querySelector('textarea[name="homeHeroHtml"]'),
        postHeaderHtml: form.querySelector('textarea[name="postHeaderHtml"]'),
        tagHeaderHtml: form.querySelector('textarea[name="tagHeaderHtml"]'),
        pageHeaderHtml: form.querySelector('textarea[name="pageHeaderHtml"]'),
      };

      (async () => {
        const settingsResp = await fetch('/api/admin/settings');
        if (settingsResp.status === 401) {
          location.href = '/admin';
          return;
        }
        const settings = await settingsResp.json();
        fields.title.value = settings.title || '';
        fields.description.value = settings.description || '';
        fields.menu.value = JSON.stringify(settings.menu || [], null, 2);
        fields.footer.value = settings.footer || '';
        fields.analyticsJs.value = settings.analyticsJs || '';
        fields.homeTemplate.value = settings.templates?.home || 'classic';
        fields.postTemplate.value = settings.templates?.post || 'classic';
        fields.tagTemplate.value = settings.templates?.tag || 'classic';
        fields.pageTemplate.value = settings.templates?.page || 'classic';
        fields.homeHeroHtml.value = settings.templateContent?.homeHeroHtml || '';
        fields.postHeaderHtml.value = settings.templateContent?.postHeaderHtml || '';
        fields.tagHeaderHtml.value = settings.templateContent?.tagHeaderHtml || '';
        fields.pageHeaderHtml.value = settings.templateContent?.pageHeaderHtml || '';

        const themeResp = await fetch('/api/admin/themes');
        if (themeResp.ok) {
          const theme = await themeResp.json();
          cssInput.value = theme.css || '';
        }
      })();

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        msg.textContent = 'Saving...';
        const payload = {
          title: fields.title.value,
          description: fields.description.value,
          menu: JSON.parse(fields.menu.value || '[]'),
          footer: fields.footer.value,
          analyticsJs: fields.analyticsJs.value,
          templates: {
            home: fields.homeTemplate.value,
            post: fields.postTemplate.value,
            tag: fields.tagTemplate.value,
            page: fields.pageTemplate.value,
          },
          templateContent: {
            homeHeroHtml: fields.homeHeroHtml.value,
            postHeaderHtml: fields.postHeaderHtml.value,
            tagHeaderHtml: fields.tagHeaderHtml.value,
            pageHeaderHtml: fields.pageHeaderHtml.value,
          },
        };

        const settingsResp = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const themeResp = await fetch('/api/admin/themes', {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ css: cssInput.value }),
        });

        if (settingsResp.ok && themeResp.ok) {
          msg.textContent = 'Saved';
        } else {
          msg.textContent = `Save failed: ${await settingsResp.text()} ${await themeResp.text()}`;
        }
      });
    })();
  </script>
</AdminLayout>
