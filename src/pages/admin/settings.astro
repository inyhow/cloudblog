---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout title="网站设置">
  <h1 class="mb-4 text-2xl font-bold">网站设置</h1>
  <form id="settings-form" class="grid gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
    <input class="rounded border px-3 py-2" name="title" placeholder="SEO 标题" />
    <input class="rounded border px-3 py-2" name="description" placeholder="SEO 描述" />
    <textarea class="rounded border px-3 py-2" name="menu" placeholder='菜单 JSON: [{"label":"首页","href":"/"}]'></textarea>
    <textarea class="rounded border px-3 py-2" name="footer" placeholder="页脚文本"></textarea>
    <textarea class="rounded border px-3 py-2" name="analyticsJs" placeholder="统计 JS"></textarea>
    <div class="grid gap-3 md:grid-cols-2">
      <label class="grid gap-1">
        <span class="text-sm">首页模板</span>
        <select class="rounded border px-3 py-2" name="homeTemplate">
          <option value="classic">classic</option>
          <option value="magazine">magazine</option>
          <option value="minimal">minimal</option>
        </select>
      </label>
      <label class="grid gap-1">
        <span class="text-sm">内页模板</span>
        <select class="rounded border px-3 py-2" name="postTemplate">
          <option value="classic">classic</option>
          <option value="cover">cover</option>
          <option value="minimal">minimal</option>
        </select>
      </label>
      <label class="grid gap-1">
        <span class="text-sm">Tag 模板</span>
        <select class="rounded border px-3 py-2" name="tagTemplate">
          <option value="classic">classic</option>
          <option value="grid">grid</option>
          <option value="minimal">minimal</option>
        </select>
      </label>
      <label class="grid gap-1">
        <span class="text-sm">单页模板</span>
        <select class="rounded border px-3 py-2" name="pageTemplate">
          <option value="classic">classic</option>
          <option value="minimal">minimal</option>
        </select>
      </label>
    </div>
    <button class="rounded bg-slate-900 px-3 py-2 text-white" type="submit">保存设置</button>
  </form>
  <form id="theme-form" class="mt-6 grid gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
    <h2 class="text-lg font-semibold">主题样式</h2>
    <textarea class="min-h-48 rounded border px-3 py-2 font-mono" name="css" placeholder="自定义主题 CSS"></textarea>
    <button class="rounded bg-slate-900 px-3 py-2 text-white" type="submit">保存主题</button>
  </form>
  <p id="msg" class="mt-2 text-sm"></p>
  <script is:inline>
    (() => {
      const form = document.getElementById('settings-form');
      const themeForm = document.getElementById('theme-form');
      const msg = document.getElementById('msg');
      const titleInput = form.querySelector('input[name="title"]');
      const descriptionInput = form.querySelector('input[name="description"]');
      const menuInput = form.querySelector('textarea[name="menu"]');
      const footerInput = form.querySelector('textarea[name="footer"]');
      const analyticsInput = form.querySelector('textarea[name="analyticsJs"]');
      const homeTemplateInput = form.querySelector('select[name="homeTemplate"]');
      const postTemplateInput = form.querySelector('select[name="postTemplate"]');
      const tagTemplateInput = form.querySelector('select[name="tagTemplate"]');
      const pageTemplateInput = form.querySelector('select[name="pageTemplate"]');
      const cssInput = themeForm.querySelector('textarea[name="css"]');

      (async () => {
        const settingsResp = await fetch('/api/admin/settings');
        if (settingsResp.status === 401) {
          location.href = '/admin';
          return;
        }
        const settings = await settingsResp.json();
        titleInput.value = settings.title || '';
        descriptionInput.value = settings.description || '';
        menuInput.value = JSON.stringify(settings.menu || [], null, 2);
        footerInput.value = settings.footer || '';
        analyticsInput.value = settings.analyticsJs || '';
        homeTemplateInput.value = settings.templates?.home || 'classic';
        postTemplateInput.value = settings.templates?.post || 'classic';
        tagTemplateInput.value = settings.templates?.tag || 'classic';
        pageTemplateInput.value = settings.templates?.page || 'classic';

        const themeResp = await fetch('/api/admin/themes');
        if (themeResp.ok) {
          const theme = await themeResp.json();
          cssInput.value = theme.css || '';
        }
      })();

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          title: titleInput.value,
          description: descriptionInput.value,
          menu: JSON.parse(menuInput.value || '[]'),
          footer: footerInput.value,
          analyticsJs: analyticsInput.value,
          templates: {
            home: homeTemplateInput.value,
            post: postTemplateInput.value,
            tag: tagTemplateInput.value,
            page: pageTemplateInput.value,
          },
        };
        const resp = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const text = await resp.text();
        msg.className = resp.ok ? 'mt-2 text-sm text-emerald-600' : 'mt-2 text-sm text-red-600';
        msg.textContent = resp.ok ? '设置保存成功' : `设置保存失败: ${text}`;
      });

      themeForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const resp = await fetch('/api/admin/themes', {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ css: cssInput.value }),
        });
        const text = await resp.text();
        msg.className = resp.ok ? 'mt-2 text-sm text-emerald-600' : 'mt-2 text-sm text-red-600';
        msg.textContent = resp.ok ? '主题保存成功' : `主题保存失败: ${text}`;
      });
    })();
  </script>
</SiteLayout>
