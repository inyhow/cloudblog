---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Settings">
  <div class="mb-6">
    <h1 class="text-3xl font-semibold text-white">Site Settings</h1>
    <p class="mt-2 text-sm text-slate-300">Lean mode: keep core settings visible, move complex options to Advanced.</p>
  </div>

  <div class="mb-4 flex flex-wrap gap-2" id="tabs">
    <button data-tab="base" class="rounded-xl border border-white/10 px-3 py-2 text-sm">Site Base</button>
    <button data-tab="seo" class="rounded-xl border border-white/10 px-3 py-2 text-sm">SEO</button>
    <button data-tab="theme" class="rounded-xl border border-white/10 px-3 py-2 text-sm">Theme & Layout</button>
  </div>

  <form id="settings-form" class="grid gap-6">
    <section data-panel="base" class="panel rounded-2xl border border-white/10 bg-slate-900/60 p-5">
      <div class="grid gap-3">
        <label class="grid gap-1">
          <span class="text-sm text-slate-300">Language</span>
          <select class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="locale">
            <option value="en">English</option>
            <option value="zh-CN">简体中文</option>
          </select>
        </label>
        <input class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="title" placeholder="Site title" />
        <input class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="description" placeholder="Site description" />
        <textarea class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="footer" placeholder="Footer text"></textarea>
      </div>
    </section>

    <section data-panel="seo" class="panel hidden grid gap-6">
      <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
        <h3 class="mb-4 text-sm font-bold uppercase tracking-widest text-slate-400">SEO Config</h3>
        <div class="grid gap-3">
          <input class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="homeTitle" placeholder="Homepage SEO title" />
          <input class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="homeDescription" placeholder="Homepage SEO description" />
          <input class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="googleAnalyticsId" placeholder="Google Analytics ID (G-XXXX)" />
          <input class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="googleSiteVerification" placeholder="Google Search Console verification token" />
          <input class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="googleAdsenseClient" placeholder="Google AdSense client (ca-pub-xxxx)" />
        </div>
      </div>
    </section>

    <section data-panel="theme" class="panel hidden grid gap-6">
      <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5 font-display">
        <h3 class="mb-4 text-sm font-bold uppercase tracking-widest text-slate-400">Site-wide Theme Preset</h3>
        <div class="grid gap-4">
          <label class="grid gap-1">
            <span class="text-sm text-slate-300">Choose Preset Layout Style</span>
            <select class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 text-lg font-bold text-amber-400" id="theme-preset">
              <option value="classic">Standard Blog (Dynamic)</option>
              <option value="imoo">Amazon Affiliate Landing (imoo)</option>
              <option value="custom">Custom (Manual Override)</option>
            </select>
            <p class="mt-1 text-[10px] text-slate-500">Note: Selecting a preset will automatically update all page layout settings below.</p>
          </label>
        </div>
      </div>

      <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
        <h3 class="mb-4 text-sm font-bold uppercase tracking-widest text-slate-400">Detailed Layout Config</h3>
        <div class="grid gap-3 md:grid-cols-2">
          <label class="grid gap-1">
            <span class="text-sm text-slate-300">Home Template</span>
            <select class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="homeTemplate">
              <option value="classic">Classic Blog</option>
              <option value="magazine">Magazine</option>
              <option value="minimal">Minimalist</option>
              <option value="imoo">imoo index.html</option>
            </select>
          </label>
          <label class="grid gap-1">
            <span class="text-sm text-slate-300">Article Template</span>
            <select class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="postTemplate">
              <option value="classic">Classic Blog</option>
              <option value="cover">Cover</option>
              <option value="minimal">Minimal</option>
              <option value="imoo">imoo product_detail.html</option>
            </select>
          </label>
          <label class="grid gap-1">
            <span class="text-sm text-slate-300">Single Page Template</span>
            <select class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="pageTemplate">
              <option value="classic">Classic Page</option>
              <option value="minimal">Minimal</option>
              <option value="imoo">imoo single.html</option>
            </select>
          </label>
          <label class="grid gap-1">
            <span class="text-sm text-slate-300">Tags Template</span>
            <select class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="tagTemplate">
              <option value="classic">Classic Tag</option>
              <option value="grid">Grid Layout</option>
              <option value="minimal">Minimal</option>
              <option value="imoo">imoo archive style</option>
            </select>
          </label>
        </div>
      </div>

      <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
        <h3 class="mb-4 text-sm font-bold uppercase tracking-widest text-slate-400">Navigation</h3>
        <div class="grid gap-3">
          <textarea class="min-h-24 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="menu" placeholder='Navigation Menu JSON: [{"label": "Home", "href": "/"}, ...]'></textarea>
        </div>
      </div>

      <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
        <div class="mb-2 text-sm font-bold uppercase tracking-widest text-slate-400">Global Variables (JSON)</div>
        <textarea class="min-h-32 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="templateVariables" placeholder='{"contact_email": "...", "amazon_tag": "..."}'></textarea>
      </div>

      <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
        <div class="mb-2 text-sm font-bold uppercase tracking-widest text-slate-400">Global Extra CSS</div>
        <textarea class="min-h-56 w-full rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="css" id="css"></textarea>
      </div>
    </section>

    <details class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
      <summary class="cursor-pointer text-sm font-medium text-slate-200">System Fragments (Developer Only)</summary>
      <div class="mt-3 grid gap-3">
        <textarea class="min-h-24 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="analyticsJs" placeholder="Head Injection JS"></textarea>
        <textarea class="min-h-20 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="homeHeroHtml" placeholder="Home Hero Snippet"></textarea>
        <textarea class="min-h-20 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="postHeaderHtml" placeholder="Article Header Snippet"></textarea>
        <textarea class="min-h-20 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="tagHeaderHtml" placeholder="Tag Header Snippet"></textarea>
        <textarea class="min-h-20 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono text-sm" name="pageHeaderHtml" placeholder="Page Header Snippet"></textarea>
      </div>
    </details>

    <div class="flex gap-3">
      <button id="save-settings" class="rounded-xl bg-amber-400 px-4 py-2 font-medium text-slate-950 transition disabled:cursor-not-allowed disabled:opacity-60" type="submit"><span data-label>Save Settings</span></button>
      <a class="rounded-xl border border-white/10 px-4 py-2 text-slate-200" href="/admin/posts">Back</a>
    </div>
  </form>

  <p id="msg" class="mt-4 text-sm text-slate-300"></p>

  <script is:inline>
    (() => {
      const form = document.getElementById('settings-form');
      const msg = document.getElementById('msg');
      const tabs = document.getElementById('tabs');
      const saveButton = document.getElementById('save-settings');
      const saveLabel = saveButton?.querySelector('[data-label]');
      const preset = document.getElementById('theme-preset');
      let isDirty = false;
      let isSaving = false;
      let settingsSha = null;
      let themeSha = null;

      function switchTab(tab) {
        form.querySelectorAll('[data-panel]').forEach((panel) => panel.classList.toggle('hidden', panel.dataset.panel !== tab));
        tabs.querySelectorAll('[data-tab]').forEach((button) => {
          const on = button.dataset.tab === tab;
          button.classList.toggle('bg-amber-400', on);
          button.classList.toggle('text-slate-950', on);
        });
      }
      tabs.querySelectorAll('[data-tab]').forEach((button) => button.addEventListener('click', () => switchTab(button.dataset.tab)));
      switchTab('base');

      const pick = (s) => form.querySelector(s);
      const f = {
        locale: pick('select[name="locale"]'),
        title: pick('input[name="title"]'),
        description: pick('input[name="description"]'),
        menu: pick('textarea[name="menu"]'),
        footer: pick('textarea[name="footer"]'),
        analyticsJs: pick('textarea[name="analyticsJs"]'),
        homeTitle: pick('input[name="homeTitle"]'),
        homeDescription: pick('input[name="homeDescription"]'),
        googleAnalyticsId: pick('input[name="googleAnalyticsId"]'),
        googleSiteVerification: pick('input[name="googleSiteVerification"]'),
        googleAdsenseClient: pick('input[name="googleAdsenseClient"]'),
        homeTemplate: pick('select[name="homeTemplate"]'),
        postTemplate: pick('select[name="postTemplate"]'),
        tagTemplate: pick('select[name="tagTemplate"]'),
        pageTemplate: pick('select[name="pageTemplate"]'),
        homeHeroHtml: pick('textarea[name="homeHeroHtml"]'),
        postHeaderHtml: pick('textarea[name="postHeaderHtml"]'),
        tagHeaderHtml: pick('textarea[name="tagHeaderHtml"]'),
        pageHeaderHtml: pick('textarea[name="pageHeaderHtml"]'),
        templateVariables: pick('textarea[name="templateVariables"]'),
        css: document.getElementById('css'),
      };
      let initialCss = '';

      function setMessage(text, tone = 'info') {
        msg.className = `mt-4 text-sm ${tone === 'error' ? 'text-red-400' : tone === 'success' ? 'text-emerald-300' : 'text-slate-300'}`;
        msg.textContent = text;
      }

      function setSavingState(saving) {
        if (saveButton) saveButton.disabled = saving;
        if (saveLabel) saveLabel.textContent = saving ? 'Saving...' : 'Save Settings';
      }

      function markDirty() {
        if (isSaving) return;
        isDirty = true;
      }

      async function fetchWithRetry(url, options = {}, retries = 1) {
        let lastError;
        for (let i = 0; i <= retries; i += 1) {
          try {
            const resp = await fetch(url, options);
            if (resp.ok || i === retries) return resp;
            lastError = new Error(`HTTP ${resp.status}`);
          } catch (err) {
            lastError = err;
            if (i === retries) throw err;
          }
          await new Promise((r) => setTimeout(r, 400 * (i + 1)));
        }
        throw lastError;
      }

      function parseJsonField(raw, fallback, label) {
        const value = String(raw || '').trim();
        if (!value) return fallback;
        try {
          return JSON.parse(value);
        } catch {
          throw new Error(`${label} JSON 格式错误`);
        }
      }

      function updatePreset() {
        const allImoo =
          f.homeTemplate.value === 'imoo' &&
          f.postTemplate.value === 'imoo' &&
          f.tagTemplate.value === 'imoo' &&
          f.pageTemplate.value === 'imoo';
        const allClassic =
          f.homeTemplate.value === 'classic' &&
          f.postTemplate.value === 'classic' &&
          f.tagTemplate.value === 'classic' &&
          f.pageTemplate.value === 'classic';

        if (allImoo) {
          preset.value = 'imoo';
        } else if (allClassic) {
          preset.value = 'classic';
        } else {
          preset.value = 'custom';
        }
      }

      (async () => {
        try {
          setMessage('Loading settings...', 'info');
          const settingsResp = await fetchWithRetry('/api/admin/settings', {}, 1);
          if (settingsResp.status === 401) return (location.href = '/admin');
          const settings = await settingsResp.json();
          settingsSha = settings._meta?.settingsSha ?? null;
          themeSha = settings._meta?.themeSha ?? null;
          f.locale.value = settings.locale || 'en';
          f.title.value = settings.title || '';
          f.description.value = settings.description || '';
          f.menu.value = JSON.stringify(settings.menu || [], null, 2);
          f.footer.value = settings.footer || '';
          f.analyticsJs.value = settings.analyticsJs || '';
          f.homeTitle.value = settings.seo?.homeTitle || '';
          f.homeDescription.value = settings.seo?.homeDescription || '';
          f.googleAnalyticsId.value = settings.seo?.googleAnalyticsId || '';
          f.googleSiteVerification.value = settings.seo?.googleSiteVerification || '';
          f.googleAdsenseClient.value = settings.seo?.googleAdsenseClient || '';
          f.homeTemplate.value = settings.templates?.home || 'classic';
          f.postTemplate.value = settings.templates?.post || 'classic';
          f.tagTemplate.value = settings.templates?.tag || 'classic';
          f.pageTemplate.value = settings.templates?.page || 'classic';
          f.homeHeroHtml.value = settings.templateContent?.homeHeroHtml || '';
          f.postHeaderHtml.value = settings.templateContent?.postHeaderHtml || '';
          f.tagHeaderHtml.value = settings.templateContent?.tagHeaderHtml || '';
          f.pageHeaderHtml.value = settings.templateContent?.pageHeaderHtml || '';
          f.templateVariables.value = JSON.stringify(settings.templateVariables || {}, null, 2);
          f.css.value = settings.themeCss || '';
          initialCss = f.css.value;
          updatePreset();
          isDirty = false;
          setMessage('');
        } catch (error) {
          setMessage(`Load failed: ${error instanceof Error ? error.message : String(error)}`, 'error');
        }
      })();

      form.addEventListener('input', markDirty);
      [f.homeTemplate, f.postTemplate, f.tagTemplate, f.pageTemplate].forEach((input) => {
        input?.addEventListener('change', updatePreset);
      });

      window.addEventListener('beforeunload', (event) => {
        if (!isDirty || isSaving) return;
        event.preventDefault();
        event.returnValue = '';
      });

      preset?.addEventListener('change', () => {
        if (preset.value === 'imoo') {
          f.homeTemplate.value = 'imoo';
          f.postTemplate.value = 'imoo';
          f.tagTemplate.value = 'imoo';
          f.pageTemplate.value = 'imoo';
        } else if (preset.value === 'classic') {
          f.homeTemplate.value = 'classic';
          f.postTemplate.value = 'classic';
          f.tagTemplate.value = 'classic';
          f.pageTemplate.value = 'classic';
        }
        markDirty();
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (isSaving) return;
        isSaving = true;
        setSavingState(true);

        try {
          const cssChanged = f.css.value !== initialCss;
          setMessage(cssChanged ? 'Saving settings and theme...' : 'Saving settings...', 'info');
          const payload = {
            locale: f.locale.value,
            title: f.title.value,
            description: f.description.value,
            menu: parseJsonField(f.menu.value, [], 'Navigation Menu'),
            footer: f.footer.value,
            analyticsJs: f.analyticsJs.value,
            seo: {
              homeTitle: f.homeTitle.value,
              homeDescription: f.homeDescription.value,
              googleAnalyticsId: f.googleAnalyticsId.value,
              googleSiteVerification: f.googleSiteVerification.value,
              googleAdsenseClient: f.googleAdsenseClient.value,
            },
            templates: {
              home: f.homeTemplate.value,
              post: f.postTemplate.value,
              tag: f.tagTemplate.value,
              page: f.pageTemplate.value,
            },
            templateContent: {
              homeHeroHtml: f.homeHeroHtml.value,
              postHeaderHtml: f.postHeaderHtml.value,
              tagHeaderHtml: f.tagHeaderHtml.value,
              pageHeaderHtml: f.pageHeaderHtml.value,
            },
            templateVariables: parseJsonField(f.templateVariables.value, {}, 'Global Variables'),
            themeCss: f.css.value,
            saveTheme: cssChanged,
            _meta: {
              settingsSha,
              themeSha,
            },
          };

          const response = await fetchWithRetry(
            '/api/admin/settings',
            {
              method: 'PUT',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify(payload),
            },
            0,
          );

          if (response.status === 401) return (location.href = '/admin');
          const result = await response.json().catch(() => ({}));
          if (!response.ok) {
            const detail = result?.error || result?.message || response.status;
            setMessage(`Save failed: ${detail}`, 'error');
            return;
          }

          settingsSha = Object.prototype.hasOwnProperty.call(result, 'settingsSha') ? result.settingsSha ?? null : settingsSha;
          themeSha = Object.prototype.hasOwnProperty.call(result, 'themeSha') ? result.themeSha ?? null : themeSha;
          if (cssChanged) initialCss = f.css.value;
          setMessage('Saved successfully', 'success');
          isDirty = false;
        } catch (error) {
          setMessage(`Save failed: ${error instanceof Error ? error.message : String(error)}`, 'error');
        } finally {
          isSaving = false;
          setSavingState(false);
        }
      });
    })();
  </script>
</AdminLayout>
