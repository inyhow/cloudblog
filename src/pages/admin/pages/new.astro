---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Page Editor">
  <div class="mb-6">
    <h1 class="text-3xl font-semibold text-white">Page Editor</h1>
    <p class="mt-2 text-sm text-slate-300">Create standalone pages rendered at `/p/slug`.</p>
  </div>
  <form id="form" class="grid gap-4 rounded-2xl border border-white/10 bg-slate-900/60 p-5">
    <div class="grid gap-3">
      <input class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="title" placeholder="Title *" required />
      <input class="rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="slug" placeholder="Slug (leave empty to auto-generate)" />
      <textarea class="min-h-24 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="description" placeholder="Page description (optional)"></textarea>
    </div>

    <!-- imoo Params -->
    <div id="imoo-params" class="hidden grid gap-3 rounded-xl border border-amber-400/20 bg-amber-400/5 p-4">
      <p class="text-[10px] font-bold uppercase tracking-widest text-amber-500">imoo parameters</p>
      <div class="grid gap-3 md:grid-cols-3">
        <input class="rounded-lg border border-white/10 bg-slate-950/60 px-3 py-2 text-sm" name="heroImage" placeholder="Hero Image URL" />
        <input class="rounded-lg border border-white/10 bg-slate-950/60 px-3 py-2 text-sm" name="price" placeholder="Price (e.g. $199)" />
        <input class="rounded-lg border border-white/10 bg-slate-950/60 px-3 py-2 text-sm" name="affiliateLink" placeholder="Purchase Link" />
      </div>
    </div>

    <textarea class="min-h-96 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 font-mono" name="content" placeholder="# Layout content (Markdown)"></textarea>
    <div class="flex gap-3">
      <button class="rounded-xl bg-amber-400 px-4 py-2 font-medium text-slate-950" type="submit">Save Page</button>
      <a class="rounded-xl border border-white/10 px-4 py-2 text-slate-200" href="/admin/pages">Back</a>
    </div>
  </form>
  <p id="msg" class="mt-3 text-sm text-slate-300"></p>
  <script is:inline>
    (() => {
      const form = document.getElementById('form');
      const msg = document.getElementById('msg');
      const slug = new URL(location.href).searchParams.get('slug');
      let isDirty = false;
      let isSaving = false;

      const titleInput = form.querySelector('input[name="title"]');
      const slugInput = form.querySelector('input[name="slug"]');
      const descriptionInput = form.querySelector('textarea[name="description"]');
      const contentInput = form.querySelector('textarea[name="content"]');
      
      const imooPanel = document.getElementById('imoo-params');
      const imooHero = form.querySelector('input[name="heroImage"]');
      const imooPrice = form.querySelector('input[name="price"]');
      const imooLink = form.querySelector('input[name="affiliateLink"]');

      function setMessage(text, tone = 'info') {
        msg.className = `mt-3 text-sm ${tone === 'error' ? 'text-red-400' : tone === 'success' ? 'text-emerald-300' : 'text-slate-300'}`;
        msg.textContent = text;
      }

      function markDirty() {
        if (isSaving) return;
        isDirty = true;
      }

      async function fetchWithRetry(url, options = {}, retries = 1) {
        let lastError;
        for (let i = 0; i <= retries; i += 1) {
          try {
            const resp = await fetch(url, options);
            if (resp.ok || i === retries) return resp;
            lastError = new Error(`HTTP ${resp.status}`);
          } catch (err) {
            lastError = err;
            if (i === retries) throw err;
          }
          await new Promise((r) => setTimeout(r, 400 * (i + 1)));
        }
        throw lastError;
      }

      (async () => {
        if (!slug) return;
        const resp = await fetchWithRetry(`/api/admin/pages/${encodeURIComponent(slug)}`);
        if (!resp.ok) return;
        const page = await resp.json();
        titleInput.value = page.title || '';
        slugInput.value = page.slug || '';
        descriptionInput.value = page.description || '';
        contentInput.value = page.rawContent || '';
        
        if (page.customData) {
          imooHero.value = page.customData.heroImage || '';
          imooPrice.value = page.customData.price || '';
          imooLink.value = page.customData.affiliateLink || '';
        }
        isDirty = false;
      })();

      async function initUi() {
        const resp = await fetch('/api/admin/settings');
        if (resp.ok) {
          const settings = await resp.json();
          if (settings.templates?.page === 'imoo') {
            imooPanel.classList.remove('hidden');
          }
        }
      }
      initUi();

      form.addEventListener('input', markDirty);
      window.addEventListener('beforeunload', (event) => {
        if (!isDirty || isSaving) return;
        event.preventDefault();
        event.returnValue = '';
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        isSaving = true;
        setMessage('Saving...', 'info');
        const payload = {
          title: titleInput.value.trim(),
          slug: slugInput.value.trim(),
          description: descriptionInput.value.trim(),
          content: contentInput.value,
          customData: {
            heroImage: imooHero.value.trim(),
            price: imooPrice.value.trim(),
            affiliateLink: imooLink.value.trim(),
          }
        };
        const url = slug ? `/api/admin/pages/${encodeURIComponent(slug)}` : '/api/admin/pages';
        const method = slug ? 'PUT' : 'POST';
        try {
          const resp = await fetchWithRetry(url, {
            method,
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          }, 2);
          const raw = await resp.text();
          if (!resp.ok) {
            setMessage(`Save failed (${resp.status}): ${raw}`, 'error');
            return;
          }
          const data = JSON.parse(raw);
          setMessage('Saved', 'success');
          isDirty = false;
          if (data?.slug) history.replaceState({}, '', `/admin/pages/new?slug=${encodeURIComponent(data.slug)}`);
        } catch (error) {
          setMessage(`Save failed: ${error instanceof Error ? error.message : String(error)}`, 'error');
        } finally {
          isSaving = false;
        }
      });
    })();
  </script>
</AdminLayout>
