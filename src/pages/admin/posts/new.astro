---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Post Editor">
  <!-- Vditor CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vditor@3.10.7/dist/index.css" />

  <style>
    /* ── 样式定制 ── */
    #vditor {
      border: 1px solid rgba(255,255,255,0.1) !important;
      border-radius: 0 0 16px 16px !important;
      background-color: #0d1117 !important;
    }
    .vditor-toolbar {
      background-color: #0d1117 !important;
      border-bottom: 1px solid rgba(255,255,255,0.08) !important;
      padding: 4px 10px !important;
    }
    .vditor-content {
      background-color: #0d1117 !important;
      color: #e2e8f0 !important;
    }
    .vditor-reset {
      color: #e2e8f0 !important;
    }
    /* 调整 Tab 样式 */
    .editor-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #1e293b;
      padding: 10px 16px;
      border-radius: 16px 16px 0 0;
      border: 1px solid rgba(255,255,255,0.1);
      border-bottom: none;
    }
    .editor-mode-tags {
      display: flex;
      gap: 12px;
    }
    .mode-tag {
      font-size: 12px;
      color: #94a3b8;
      cursor: pointer;
      padding: 2px 8px;
      border-radius: 4px;
      transition: all 0.2s;
    }
    .mode-tag.active {
      background: rgba(245,158,11,0.15);
      color: #fbbf24;
    }

    /* 表单美化 */
    .field-input {
      min-width: 0;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(15,23,42,0.8);
      padding: 12px 16px;
      color: #e2e8f0;
      font-size: 15px;
      width: 100%;
      outline: none;
      transition: all 0.2s;
    }
    .field-input:focus {
      border-color: #f59e0b;
      box-shadow: 0 0 0 3px rgba(245,158,11,0.1);
    }
  </style>

  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 id="page-heading" class="text-2xl font-bold text-white">New Post</h1>
      <p class="text-sm text-slate-400">所见即所得 Markdown 编辑器 (Vditor)</p>
    </div>
    <a href="/admin/posts" class="rounded-xl border border-white/10 px-4 py-2 text-sm text-slate-300 hover:bg-white/5">← Back</a>
  </div>

  <form id="form" class="space-y-4">
    <!-- Metadata Rows -->
    <div class="grid gap-4 md:grid-cols-2">
      <input class="field-input" id="f-title" name="title" placeholder="Post Title *" required />
      <input class="field-input" id="f-slug" name="slug" placeholder="Custom Slug" />
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <input class="field-input" id="f-category" name="category" placeholder="Category" />
      <input class="field-input" id="f-tags" name="tags" placeholder="Tags (comma separated)" />
      <select class="field-input" id="f-status" name="status">
        <option value="published">Published</option>
        <option value="draft">Draft</option>
        <option value="review">In Review</option>
        <option value="scheduled">Scheduled</option>
        <option value="deleted">Recycle Bin</option>
      </select>
    </div>

    <!-- Cover & Options -->
    <div class="flex flex-wrap items-center gap-4 rounded-2xl border border-white/10 bg-slate-900/40 p-4">
      <div class="flex-1 min-w-[200px]">
        <input class="field-input" id="f-cover" name="coverImage" placeholder="Cover Image URL" />
      </div>
      <div class="flex gap-2">
        <input class="hidden" type="file" id="cover-file" accept="image/*" />
        <button class="rounded-xl border border-white/10 px-4 py-2 text-sm text-slate-200" type="button" id="cover-pick">Pick</button>
        <button class="rounded-xl bg-amber-400/10 border border-amber-400/30 px-4 py-2 text-sm text-amber-300" type="button" id="cover-upload">Upload</button>
      </div>
      <label class="flex items-center gap-2 px-4 py-2 bg-slate-800/50 rounded-xl cursor-pointer">
        <input type="checkbox" id="f-pinned" name="pinned" class="accent-amber-400" />
        <span class="text-sm text-slate-300">Pinned</span>
      </label>
    </div>

    <!-- The Editor Container -->
    <div class="editor-wrap">
      <div class="editor-header">
        <span class="text-sm font-medium text-slate-300">Article Content</span>
        <div class="editor-mode-tags">
          <span class="mode-tag active" id="mode-wysiwyg">Visual (Word)</span>
          <span class="mode-tag" id="mode-ir">Instant Render</span>
          <span class="mode-tag" id="mode-sv">Split View</span>
        </div>
      </div>
      <div id="vditor"></div>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <button class="rounded-xl bg-amber-400 px-8 py-3 font-bold text-slate-950 shadow-lg shadow-amber-400/20 active:scale-95 transition" type="submit" id="save-btn">Save Content</button>
      <button class="rounded-xl border border-white/10 px-6 py-3 text-sm text-slate-300" type="button" id="save-draft-btn">Save as Draft</button>
      <span id="msg" class="text-sm italic"></span>
    </div>
  </form>

  <section id="revisions-panel" class="mt-8 hidden space-y-3">
    <h3 class="text-sm font-bold text-slate-200 uppercase tracking-widest">Revision History</h3>
    <div id="revisions-list" class="grid gap-2"></div>
  </section>

  <!-- Vditor JS -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/vditor@3.10.7/dist/index.min.js"></script>

  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const slug = new URL(location.href).searchParams.get('slug');
      let vditor = null;
      let isSaving = false;

      // 1. Initialize Vditor
      vditor = new Vditor('vditor', {
        height: 600,
        mode: 'wysiwyg', // 默认开启“所见即所得”模式，像 Word 一样编辑
        theme: 'dark',
        cdn: 'https://cdn.jsdelivr.net/npm/vditor@3.10.7',
        toolbarConfig: {
          pin: true,
        },
        cache: {
          enable: false,
        },
        toolbar: [
          'emoji', 'headings', 'bold', 'italic', 'strike', 'link', '|',
          'list', 'ordered-list', 'check', 'outdent', 'indent', '|',
          'quote', 'line', 'code', 'inline-code', 'insert-before', 'insert-after', '|',
          'upload', 'table', '|',
          'undo', 'redo', '|',
          'fullscreen', 'edit-mode'
        ],
        upload: {
          url: '/api/admin/upload-image',
          fieldName: 'file',
          linkToImgUrl: '/api/admin/upload-image',
          handler(file) {
            // 此处可以自定义上传逻辑，对接原本的 API
            return null; 
          }
        },
        after() {
          if (slug) loadPost();
        }
      });

      // Mode switch handling
      $('mode-wysiwyg').onclick = () => { setMode('wysiwyg'); vditor.setMode('wysiwyg'); };
      $('mode-ir').onclick      = () => { setMode('ir'); vditor.setMode('ir'); };
      $('mode-sv').onclick      = () => { setMode('sv'); vditor.setMode('sv'); };

      function setMode(m) {
        document.querySelectorAll('.mode-tag').forEach(t => t.classList.remove('active'));
        $(`mode-${m}`).classList.add('active');
      }

      // 2. Load Existing Post
      async function loadPost() {
        $('page-heading').textContent = 'Edit Content';
        try {
          const resp = await fetch(`/api/admin/posts/${encodeURIComponent(slug)}`);
          if (!resp.ok) return;
          const post = await resp.json();

          $('f-title').value      = post.title || '';
          $('f-slug').value       = post.slug || '';
          $('f-category').value   = post.category || '';
          $('f-tags').value       = (post.tags || []).join(', ');
          $('f-status').value     = post.status || 'published';
          $('f-cover').value      = post.coverImage || '';
          $('f-pinned').checked   = !!post.pinned;

          vditor.setValue(post.content || '');
          loadRevisions();
        } catch (e) { console.error(e); }
      }

      async function loadRevisions() {
        const resp = await fetch(`/api/admin/posts/${encodeURIComponent(slug)}/revisions`);
        if (!resp.ok) return;
        const data = await resp.json();
        const revisions = data.revisions || [];
        if (revisions.length > 0) {
          $('revisions-panel').classList.remove('hidden');
          $('revisions-list').innerHTML = revisions.map(path => {
            const name = path.split('/').pop();
            return `
              <div class="flex items-center justify-between p-3 bg-slate-900/50 border border-white/5 rounded-xl">
                <span class="text-xs text-slate-400 font-mono">${name}</span>
                <button type="button" class="text-xs text-amber-400 hover:underline" onclick="restoreRevision('${encodeURIComponent(path)}')">Restore</button>
              </div>`;
          }).join('');
        }
      }

      window.restoreRevision = async (path) => {
        if (!confirm('Replace current content with this version?')) return;
        const resp = await fetch(`/api/admin/posts/${encodeURIComponent(slug)}/revisions`, {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ revisionPath: decodeURIComponent(path) })
        });
        if (resp.ok) location.reload();
      };

      // 3. Save Handling
      $('form').onsubmit = async (e) => {
        e.preventDefault();
        save('published');
      };

      $('save-draft-btn').onclick = () => save('draft');

      async function save(forceStatus) {
        if (isSaving) return;
        isSaving = true;
        const status = forceStatus || $('f-status').value;
        const msg = $('msg');
        msg.textContent = 'Saving...';
        msg.className = 'text-amber-400 animate-pulse';

        const payload = {
          title: $('f-title').value,
          slug: $('f-slug').value,
          description: '', // Can be expanded
          category: $('f-category').value,
          tags: $('f-tags').value.split(',').map(t => t.trim()).filter(Boolean),
          status: status,
          pinned: $('f-pinned').checked,
          coverImage: $('f-cover').value,
          content: vditor.getValue()
        };

        const url = slug ? `/api/admin/posts/${encodeURIComponent(slug)}` : '/api/admin/posts';
        const method = slug ? 'PUT' : 'POST';

        try {
          const resp = await fetch(url, {
            method,
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(payload)
          });
          if (resp.ok) {
            msg.textContent = 'Saved successfully ✓';
            msg.className = 'text-emerald-400';
            const data = await resp.json();
            if (!slug && data.slug) {
              location.href = `/admin/posts/new?slug=${encodeURIComponent(data.slug)}`;
            }
          } else {
            msg.textContent = 'Error: ' + await resp.text();
            msg.className = 'text-rose-400';
          }
        } catch (e) {
          msg.textContent = 'System error occurred.';
        } finally {
          isSaving = false;
        }
      }

      // 4. Image Upload (Cover)
      const coverFile = $('cover-file');
      $('cover-pick').onclick = () => coverFile.click();
      $('cover-upload').onclick = async () => {
        const file = coverFile.files[0];
        if (!file) return alert('Select a file first');
        const fd = new FormData();
        fd.append('file', file);
        try {
          const resp = await fetch('/api/admin/upload-image', {method: 'POST', body: fd});
          const data = await resp.json();
          if (data.url) $('f-cover').value = data.url;
        } catch (e) { alert('Upload failed'); }
      };

      // Auto slug
      $('f-title').oninput = () => {
        if (!slug) $('f-slug').value = $('f-title').value.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fa5]+/g, '-').replace(/^-+|-+$/g, '');
      };
    })();
  </script>
</AdminLayout>
