---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Post Editor">
  <div class="mb-6">
    <h1 class="text-3xl font-semibold text-white">Post Editor</h1>
    <p class="mt-2 text-sm text-slate-300">Write with the visual editor, upload images, and control slug, status, and cover.</p>
  </div>
  <form id="form" class="grid gap-4 overflow-x-hidden rounded-2xl border border-white/10 bg-slate-900/60 p-5 shadow-sm">
    <div class="grid gap-3 md:grid-cols-2">
      <input class="min-w-0 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="title" placeholder="Title" required />
      <input class="min-w-0 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="slug" placeholder="Custom URL slug" />
    </div>
    <input class="min-w-0 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="description" placeholder="Description" />
    <div class="grid gap-3 md:grid-cols-5">
      <input class="min-w-0 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="category" placeholder="Category slug" />
      <input class="min-w-0 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2 md:col-span-2" name="tags" placeholder="Tags (comma separated)" />
      <select class="min-w-0 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="status">
        <option value="published">Published</option>
        <option value="draft">Draft</option>
        <option value="review">In Review</option>
        <option value="scheduled">Scheduled</option>
        <option value="archived">Archived</option>
        <option value="deleted">Deleted (Recycle Bin)</option>
      </select>
      <label class="min-w-0 flex items-center gap-2 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2">
        <input type="checkbox" name="pinned" />
        <span>Pinned</span>
      </label>
    </div>
    <textarea class="min-w-0 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="reviewNote" placeholder="Review note (approval/rejection feedback)"></textarea>
    <input class="min-w-0 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="scheduledAt" type="datetime-local" placeholder="Scheduled publish time" />
    <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_auto]">
      <input class="min-w-0 rounded-xl border border-white/10 bg-slate-950/50 px-3 py-2" name="coverImage" placeholder="Cover image URL" />
      <div class="flex flex-wrap gap-2">
        <input class="hidden" type="file" id="cover-file" accept="image/*" />
        <button class="rounded-xl border border-white/10 px-3 py-2" type="button" id="cover-pick">Choose Cover</button>
        <button class="rounded-xl border border-white/10 px-3 py-2" type="button" id="cover-upload">Upload Cover</button>
      </div>
    </div>
    <div class="rounded-2xl border border-white/10 bg-slate-950/50">
      <div class="flex flex-wrap gap-2 border-b border-white/10 p-3">
        <button class="rounded-lg border border-white/10 bg-slate-900 px-3 py-1.5 text-sm" type="button" data-command="bold">Bold</button>
        <button class="rounded-lg border border-white/10 bg-slate-900 px-3 py-1.5 text-sm" type="button" data-command="italic">Italic</button>
        <button class="rounded-lg border border-white/10 bg-slate-900 px-3 py-1.5 text-sm" type="button" data-command="formatBlock" data-value="h2">H2</button>
        <button class="rounded-lg border border-white/10 bg-slate-900 px-3 py-1.5 text-sm" type="button" data-command="formatBlock" data-value="blockquote">Quote</button>
        <button class="rounded-lg border border-white/10 bg-slate-900 px-3 py-1.5 text-sm" type="button" data-command="insertUnorderedList">List</button>
        <button class="rounded-lg border border-white/10 bg-slate-900 px-3 py-1.5 text-sm" type="button" id="insert-link">Link</button>
        <button class="rounded-lg border border-white/10 bg-slate-900 px-3 py-1.5 text-sm" type="button" id="insert-code">Code</button>
        <button class="rounded-lg border border-white/10 bg-slate-900 px-3 py-1.5 text-sm" type="button" id="insert-table">Table</button>
        <button class="rounded-lg border border-white/10 bg-slate-900 px-3 py-1.5 text-sm" type="button" id="pick-inline-image">Image</button>
        <input class="hidden" type="file" id="inline-image-file" accept="image/*" />
      </div>
      <div
        id="editor"
        class="min-h-[28rem] bg-white p-4 text-slate-900 outline-none"
        contenteditable="true"
        spellcheck="false"
        data-placeholder="Write your post here..."
      ></div>
    </div>
    <details class="rounded-xl border border-white/10 bg-slate-950/50">
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium">Markdown source</summary>
      <textarea class="min-h-80 w-full border-t border-white/10 bg-transparent px-4 py-3 font-mono text-sm outline-none" name="content" id="md" placeholder="# Content"></textarea>
    </details>
    <div class="flex gap-3">
      <button class="rounded-xl bg-amber-400 px-4 py-2 font-medium text-slate-950" type="submit">Save Post</button>
      <button class="rounded-xl border border-white/10 px-4 py-2" type="button" id="sync-markdown">Sync from Markdown</button>
    </div>
  </form>
  <section id="revisions-panel" class="mt-6 hidden rounded-2xl border border-white/10 bg-slate-900/60 p-4">
    <div class="mb-3 text-sm font-medium text-slate-200">Revision History</div>
    <div id="revisions-list" class="grid gap-2"></div>
  </section>
  <p id="msg" class="mt-3 text-sm"></p>

  <script is:inline>
    (() => {
      const form = document.getElementById('form');
      const editor = document.getElementById('editor');
      const md = document.getElementById('md');
      const msg = document.getElementById('msg');
      const slug = new URL(location.href).searchParams.get('slug');
      let isDirty = false;
      let isSaving = false;

      const titleInput = form.querySelector('input[name="title"]');
      const descriptionInput = form.querySelector('input[name="description"]');
      const slugInput = form.querySelector('input[name="slug"]');
      const categoryInput = form.querySelector('input[name="category"]');
      const tagsInput = form.querySelector('input[name="tags"]');
      const statusInput = form.querySelector('select[name="status"]');
      const pinnedInput = form.querySelector('input[name="pinned"]');
      const coverImageInput = form.querySelector('input[name="coverImage"]');
      const scheduledAtInput = form.querySelector('input[name="scheduledAt"]');
      const reviewNoteInput = form.querySelector('textarea[name="reviewNote"]');

      const coverFile = document.getElementById('cover-file');
      const coverPick = document.getElementById('cover-pick');
      const coverUpload = document.getElementById('cover-upload');
      const inlineImageFile = document.getElementById('inline-image-file');
      const syncMarkdownBtn = document.getElementById('sync-markdown');
      const revisionsPanel = document.getElementById('revisions-panel');
      const revisionsList = document.getElementById('revisions-list');

      function escapeHtml(value) {
        return value
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;');
      }

      function markdownToHtml(markdown) {
        const lines = markdown.replace(/\r/g, '').split('\n');
        const html = [];
        let inList = false;
        let inCode = false;
        let codeBuffer = [];

        const closeList = () => {
          if (inList) {
            html.push('</ul>');
            inList = false;
          }
        };

        const flushCode = () => {
          if (inCode) {
            html.push(`<pre><code>${escapeHtml(codeBuffer.join('\n'))}</code></pre>`);
            inCode = false;
            codeBuffer = [];
          }
        };

        for (const line of lines) {
          if (line.startsWith('```')) {
            closeList();
            if (inCode) {
              flushCode();
            } else {
              inCode = true;
            }
            continue;
          }
          if (inCode) {
            codeBuffer.push(line);
            continue;
          }
          if (!line.trim()) {
            closeList();
            html.push('<p><br></p>');
            continue;
          }
          if (line.startsWith('## ')) {
            closeList();
            html.push(`<h2>${escapeHtml(line.slice(3))}</h2>`);
            continue;
          }
          if (line.startsWith('# ')) {
            closeList();
            html.push(`<h1>${escapeHtml(line.slice(2))}</h1>`);
            continue;
          }
          if (line.startsWith('> ')) {
            closeList();
            html.push(`<blockquote>${escapeHtml(line.slice(2))}</blockquote>`);
            continue;
          }
          if (line.startsWith('- ')) {
            if (!inList) {
              html.push('<ul>');
              inList = true;
            }
            html.push(`<li>${escapeInline(line.slice(2))}</li>`);
            continue;
          }
          closeList();
          if (/^\|.+\|$/.test(line)) {
            const cells = line.split('|').slice(1, -1).map((cell) => `<td>${escapeInline(cell.trim())}</td>`).join('');
            html.push(`<table><tbody><tr>${cells}</tr></tbody></table>`);
            continue;
          }
          html.push(`<p>${escapeInline(line)}</p>`);
        }
        closeList();
        flushCode();
        return html.join('');
      }

      function escapeInline(value) {
        let output = escapeHtml(value);
        output = output.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img alt="$1" src="$2" />');
        output = output.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
        output = output.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        output = output.replace(/\*([^*]+)\*/g, '<em>$1</em>');
        output = output.replace(/`([^`]+)`/g, '<code>$1</code>');
        return output;
      }

      function inlineToMarkdown(node) {
        if (node.nodeType === Node.TEXT_NODE) return node.textContent;
        if (node.nodeType !== Node.ELEMENT_NODE) return '';
        const tag = node.tagName.toLowerCase();
        const content = Array.from(node.childNodes).map(inlineToMarkdown).join('');
        if (tag === 'strong' || tag === 'b') return `**${content}**`;
        if (tag === 'em' || tag === 'i') return `*${content}*`;
        if (tag === 'code' && node.parentElement?.tagName.toLowerCase() !== 'pre') return `\`${content}\``;
        if (tag === 'a') return `[${content}](${node.getAttribute('href') || ''})`;
        if (tag === 'img') return `![${node.getAttribute('alt') || ''}](${node.getAttribute('src') || ''})`;
        if (tag === 'br') return '\n';
        return content;
      }

      function blockToMarkdown(node) {
        if (node.nodeType === Node.TEXT_NODE) return node.textContent.trim();
        if (node.nodeType !== Node.ELEMENT_NODE) return '';
        const tag = node.tagName.toLowerCase();
        if (tag === 'h1') return `# ${Array.from(node.childNodes).map(inlineToMarkdown).join('')}`;
        if (tag === 'h2') return `## ${Array.from(node.childNodes).map(inlineToMarkdown).join('')}`;
        if (tag === 'blockquote') return `> ${Array.from(node.childNodes).map(inlineToMarkdown).join('')}`;
        if (tag === 'ul') {
          return Array.from(node.children).map((li) => `- ${Array.from(li.childNodes).map(inlineToMarkdown).join('')}`).join('\n');
        }
        if (tag === 'pre') {
          const code = node.textContent.replace(/\n+$/, '');
          return `\`\`\`\n${code}\n\`\`\``;
        }
        if (tag === 'table') {
          return Array.from(node.querySelectorAll('tr'))
            .map((row) => `| ${Array.from(row.children).map((cell) => cell.textContent.trim()).join(' | ')} |`)
            .join('\n');
        }
        return Array.from(node.childNodes).map(inlineToMarkdown).join('');
      }

      function htmlToMarkdown(root) {
        return Array.from(root.childNodes)
          .map(blockToMarkdown)
          .filter(Boolean)
          .join('\n\n')
          .replace(/\n{3,}/g, '\n\n')
          .trim();
      }

      function syncEditorFromMarkdown() {
        editor.innerHTML = markdownToHtml(md.value || '');
      }

      function syncMarkdownFromEditor() {
        md.value = htmlToMarkdown(editor);
      }

      function setMessage(text, tone) {
        msg.className = `mt-3 text-sm ${tone === 'error' ? 'text-red-600' : tone === 'success' ? 'text-emerald-600' : 'text-slate-600'}`;
        msg.textContent = text;
      }

      function markDirty() {
        if (isSaving) return;
        isDirty = true;
      }

      async function fetchWithRetry(url, options = {}, retries = 1) {
        let lastError;
        for (let i = 0; i <= retries; i += 1) {
          try {
            const resp = await fetch(url, options);
            if (resp.ok || i === retries) return resp;
            lastError = new Error(`HTTP ${resp.status}`);
          } catch (err) {
            lastError = err;
            if (i === retries) throw err;
          }
          await new Promise((r) => setTimeout(r, 400 * (i + 1)));
        }
        throw lastError;
      }

      async function uploadImage(file) {
        const fd = new FormData();
        fd.append('file', file);
        const resp = await fetchWithRetry('/api/admin/upload-image', { method: 'POST', body: fd }, 1);
        const body = await resp.json();
        if (!resp.ok) throw new Error(body?.error || JSON.stringify(body));
        return body;
      }

      function insertHtml(html) {
        editor.focus();
        document.execCommand('insertHTML', false, html);
        syncMarkdownFromEditor();
      }

      form.querySelectorAll('[data-command]').forEach((button) => {
        button.addEventListener('click', () => {
          editor.focus();
          document.execCommand(button.dataset.command, false, button.dataset.value || null);
          syncMarkdownFromEditor();
        });
      });

      document.getElementById('insert-link').addEventListener('click', () => {
        const url = prompt('Link URL');
        if (!url) return;
        editor.focus();
        document.execCommand('createLink', false, url);
        syncMarkdownFromEditor();
      });

      document.getElementById('insert-code').addEventListener('click', () => {
        insertHtml('<pre><code>const example = true;</code></pre>');
      });

      document.getElementById('insert-table').addEventListener('click', () => {
        insertHtml('<table><tbody><tr><td>Header 1</td><td>Header 2</td></tr><tr><td>Cell 1</td><td>Cell 2</td></tr></tbody></table>');
      });

      document.getElementById('pick-inline-image').addEventListener('click', () => inlineImageFile.click());
      coverPick.addEventListener('click', () => coverFile.click());

      coverUpload.addEventListener('click', async () => {
        const file = coverFile.files?.[0];
        if (!file) return;
        try {
          setMessage('Uploading cover...', 'info');
          const body = await uploadImage(file);
          coverImageInput.value = body.url;
          setMessage('Cover uploaded', 'success');
        } catch (error) {
          setMessage(`Cover upload failed: ${error.message}`, 'error');
        }
      });

      inlineImageFile.addEventListener('change', async () => {
        const file = inlineImageFile.files?.[0];
        if (!file) return;
        try {
          setMessage('Uploading image...', 'info');
          const body = await uploadImage(file);
          insertHtml(`<p><img src="${body.url}" alt="${file.name}" /></p>`);
          setMessage('Image inserted', 'success');
          inlineImageFile.value = '';
        } catch (error) {
          setMessage(`Image upload failed: ${error.message}`, 'error');
        }
      });

      editor.addEventListener('input', syncMarkdownFromEditor);
      editor.addEventListener('input', markDirty);
      md.addEventListener('input', () => {
        if (document.activeElement === md) syncEditorFromMarkdown();
      });
      md.addEventListener('input', markDirty);
      syncMarkdownBtn.addEventListener('click', syncEditorFromMarkdown);
      form.addEventListener('input', markDirty);
      window.addEventListener('beforeunload', (event) => {
        if (!isDirty || isSaving) return;
        event.preventDefault();
        event.returnValue = '';
      });

      editor.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'b') {
          event.preventDefault();
          document.execCommand('bold');
          syncMarkdownFromEditor();
        }
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'i') {
          event.preventDefault();
          document.execCommand('italic');
          syncMarkdownFromEditor();
        }
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          document.getElementById('insert-link').click();
        }
      });

      (async () => {
        if (!slug) return;
        const resp = await fetch(`/api/admin/posts/${encodeURIComponent(slug)}`);
        if (!resp.ok) return;
        const post = await resp.json();
        titleInput.value = post.title || '';
        descriptionInput.value = post.description || '';
        slugInput.value = post.slug || '';
        tagsInput.value = (post.tags || []).join(',');
        categoryInput.value = post.category || '';
        statusInput.value = post.status || 'published';
        reviewNoteInput.value = post.reviewNote || '';
        pinnedInput.checked = !!post.pinned;
        coverImageInput.value = post.coverImage || '';
        if (post.scheduledAt) {
          scheduledAtInput.value = new Date(post.scheduledAt).toISOString().slice(0, 16);
        }
        md.value = post.content || '';
        syncEditorFromMarkdown();
        isDirty = false;

        const revisionsResp = await fetch(`/api/admin/posts/${encodeURIComponent(slug)}/revisions`);
        if (revisionsResp.ok) {
          const revisionData = await revisionsResp.json();
          const revisions = revisionData.revisions || [];
          if (revisions.length > 0) {
            revisionsPanel.classList.remove('hidden');
            revisionsList.innerHTML = revisions
              .map((path) => {
                const name = path.split('/').pop().replace('.md', '');
                return `<div class="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-slate-950/40 p-2">
                  <span class="text-xs text-slate-300">${name}</span>
                  <button class="rounded-lg border border-sky-400/50 px-2 py-1 text-xs text-sky-300" data-restore-revision="${encodeURIComponent(path)}" type="button">Restore</button>
                </div>`;
              })
              .join('');
            revisionsList.querySelectorAll('[data-restore-revision]').forEach((button) => {
              button.addEventListener('click', async () => {
                if (!confirm('Restore this revision? Current content will be replaced.')) return;
                const revisionPath = decodeURIComponent(button.dataset.restoreRevision);
                const resp = await fetch(`/api/admin/posts/${encodeURIComponent(slug)}/revisions`, {
                  method: 'POST',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ revisionPath }),
                });
                if (!resp.ok) {
                  setMessage(`Restore failed: ${await resp.text()}`, 'error');
                  return;
                }
                setMessage('Revision restored. Reloading...', 'success');
                setTimeout(() => location.reload(), 600);
              });
            });
          }
        }
      })();

      syncEditorFromMarkdown();
      isDirty = false;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        isSaving = true;
        syncMarkdownFromEditor();
        setMessage('Saving...', 'info');
        const payload = {
          title: titleInput.value.trim(),
          description: descriptionInput.value.trim(),
          slug: slugInput.value.trim(),
          tags: tagsInput.value.split(',').map((s) => s.trim()).filter(Boolean),
          category: categoryInput.value.trim(),
          status: statusInput.value,
          reviewNote: reviewNoteInput.value.trim(),
          pinned: pinnedInput.checked,
          coverImage: coverImageInput.value.trim(),
          scheduledAt: scheduledAtInput.value ? new Date(scheduledAtInput.value).toISOString() : '',
          content: md.value,
        };
        const url = slug ? `/api/admin/posts/${encodeURIComponent(slug)}` : '/api/admin/posts';
        const method = slug ? 'PUT' : 'POST';
        try {
          const resp = await fetchWithRetry(url, {
            method,
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          }, 2);
          const text = await resp.text();
          if (resp.ok) {
            try {
              const data = JSON.parse(text);
              if (data?.slug) {
                const next = `/admin/posts/new?slug=${encodeURIComponent(data.slug)}`;
                if (location.pathname + location.search !== next) history.replaceState({}, '', next);
              }
            } catch {}
            setMessage('Saved', 'success');
            isDirty = false;
            return;
          }
          setMessage(`Save failed (${resp.status}): ${text}`, 'error');
        } catch (error) {
          setMessage(`Save failed: ${error instanceof Error ? error.message : String(error)}`, 'error');
        } finally {
          isSaving = false;
        }
      });
    })();
  </script>
</AdminLayout>
