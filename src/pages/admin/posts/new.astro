---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Post Editor">
  <!-- Vditor CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vditor@3.10.7/dist/index.css" />

  <style>
    /* ── 样式定制 ── */
    #vditor {
      border: 1px solid rgba(255,255,255,0.1) !important;
      border-radius: 0 0 16px 16px !important;
      background-color: #ffffff !important;
      overflow: hidden;
    }
    #vditor.vditor--dark {
      --border-color: rgba(148,163,184,0.35);
      --second-color: #94a3b8;
      --panel-background-color: #ffffff;
      --panel-shadow: 0 1px 2px rgba(15,23,42,0.08);
      --toolbar-background-color: #f8fafc;
      --toolbar-icon-color: #334155;
      --toolbar-icon-hover-color: #0f172a;
      --textarea-background-color: #ffffff;
      --textarea-text-color: #0f172a;
      --resize-icon-color: rgba(148,163,184,0.45);
      --resize-background-color: rgba(148,163,184,0.12);
      --resize-hover-icon-color: #0f172a;
      --resize-hover-background-color: rgba(148,163,184,0.22);
      --count-background-color: rgba(251,191,36,0.16);
      --heading-border-color: #cbd5e1;
      --blockquote-color: #64748b;
      --ir-heading-color: #7c3aed;
      --ir-title-color: #64748b;
      --ir-bi-color: #c2410c;
      --ir-link-color: #2563eb;
      --ir-bracket-color: #475569;
      --ir-paren-color: #059669;
    }
    #vditor:focus-within {
      box-shadow: 0 0 0 3px rgba(245,158,11,0.12);
    }
    .vditor-toolbar {
      background-color: #f8fafc !important;
      border-bottom: 1px solid rgba(148,163,184,0.28) !important;
      padding: 4px 10px !important;
    }
    .vditor-toolbar button {
      color: #334155 !important;
    }
    .vditor-toolbar button:hover {
      background: rgba(148,163,184,0.12) !important;
    }
    .vditor-content,
    .vditor-reset,
    .vditor-reset *,
    #vditor textarea,
    #vditor .CodeMirror,
    #vditor .CodeMirror-scroll,
    #vditor .CodeMirror pre,
    #vditor .vditor-ir textarea,
    #vditor .vditor-sv textarea,
    #vditor .vditor-wysiwyg,
    #vditor .vditor-preview {
      background-color: #ffffff !important;
      color: #0f172a !important;
      text-shadow: none !important;
      caret-color: #b45309 !important;
    }
    #vditor .vditor-wysiwyg {
      padding: 18px 20px !important;
    }
    #vditor .vditor-sv:focus,
    #vditor .vditor-wysiwyg:focus,
    #vditor .vditor-ir:focus,
    #vditor .vditor-preview,
    #vditor .vditor-preview > .vditor-reset,
    #vditor .vditor-devtools {
      background-color: #ffffff !important;
      color: #0f172a !important;
    }
    #vditor .vditor-toolbar [data-type='edit-mode'] {
      display: none !important;
    }
    #vditor.editor-mode-markdown .vditor-sv__preview,
    #vditor.editor-mode-markdown .vditor-sv__resize {
      display: none !important;
    }
    #vditor.editor-mode-markdown .vditor-sv__editor,
    #vditor.editor-mode-markdown .vditor-sv__editor .CodeMirror,
    #vditor.editor-mode-markdown .vditor-sv__editor .CodeMirror-scroll {
      width: 100% !important;
      max-width: 100% !important;
      flex: 1 1 auto !important;
    }
    #vditor textarea::placeholder,
    #vditor [contenteditable='true'][data-placeholder]:empty::before {
      color: #94a3b8 !important;
    }
    #vditor textarea::selection,
    #vditor .CodeMirror-line::selection,
    #vditor .CodeMirror-line > span::selection,
    #vditor [contenteditable='true']::selection {
      background: rgba(251,191,36,0.28) !important;
      color: #111827 !important;
    }
    #vditor .vditor-counter,
    #vditor .vditor-tooltipped,
    #vditor .vditor-outline__item,
    #vditor .vditor-preview__action {
      color: #475569 !important;
    }
    #vditor pre,
    #vditor code {
      background-color: #f8fafc !important;
      color: #0f172a !important;
    }
    .editor-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      background: #1e293b;
      padding: 10px 16px;
      border-radius: 16px 16px 0 0;
      border: 1px solid rgba(255,255,255,0.1);
      border-bottom: none;
    }
    .editor-meta {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .editor-mode-tags {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: center;
    }
    .mode-tag {
      font-size: 12px;
      color: #cbd5e1;
      cursor: pointer;
      padding: 6px 10px;
      border-radius: 999px;
      transition: all 0.2s;
      border: 1px solid transparent;
      background: rgba(15,23,42,0.45);
    }
    .mode-tag:hover {
      border-color: rgba(245,158,11,0.35);
      color: #f8fafc;
    }
    .mode-tag.active {
      background: rgba(245,158,11,0.15);
      border-color: rgba(245,158,11,0.35);
      color: #fbbf24;
    }
    .editor-state {
      font-size: 12px;
      color: #fdba74;
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(245,158,11,0.12);
      border: 1px solid rgba(245,158,11,0.25);
      white-space: nowrap;
    }

    /* 表单美化 */
    .field-input {
      min-width: 0;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(15,23,42,0.8);
      padding: 12px 16px;
      color: #e2e8f0;
      font-size: 15px;
      width: 100%;
      outline: none;
      transition: all 0.2s;
    }
    .field-input::placeholder {
      color: #64748b;
    }
    .field-input:focus {
      border-color: #f59e0b;
      box-shadow: 0 0 0 3px rgba(245,158,11,0.1);
    }
  </style>

  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 id="page-heading" class="text-2xl font-bold text-white">New Post</h1>
      <p class="text-sm text-slate-400">所见即所得 Markdown 编辑器 (Vditor)</p>
    </div>
    <a href="/admin/posts" class="rounded-xl border border-white/10 px-4 py-2 text-sm text-slate-300 hover:bg-white/5">← Back</a>
  </div>

  <form id="form" class="space-y-4">
    <!-- Metadata Rows -->
    <div class="grid gap-4 md:grid-cols-2">
      <input class="field-input" id="f-title" name="title" placeholder="Post Title *" required />
      <input class="field-input" id="f-slug" name="slug" placeholder="Custom Slug" />
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      <input class="field-input" id="f-tags" name="tags" placeholder="Tags (comma separated)" />
      <select class="field-input border-emerald-500/30" id="f-status" name="status">
        <option value="published">Published</option>
        <option value="draft">Draft</option>
        <option value="deleted">Recycle Bin</option>
      </select>
    </div>

    <!-- Custom Data Row (Template Specific) -->
    <div id="custom-data-panel" class="hidden grid gap-4 md:grid-cols-3 rounded-2xl border border-amber-400/20 bg-amber-400/5 p-4">
      <div class="md:col-span-3 text-xs font-bold text-amber-500/80 uppercase tracking-tighter">Template Parameters</div>
      <input class="field-input" id="f-price" placeholder="Product Price (e.g. $99.00)" />
      <input class="field-input" id="f-affLink" placeholder="Affiliate Link" />
      <input class="field-input" id="f-heroImg" placeholder="Hero Image URL" />
    </div>

    <!-- Cover & Options -->
    <div class="flex flex-wrap items-center gap-4 rounded-2xl border border-white/10 bg-slate-900/40 p-4">
      <div class="min-w-[200px] flex-1">
        <input class="field-input" id="f-cover" name="coverImage" placeholder="Cover Image URL" />
      </div>
      <div class="flex gap-2">
        <input class="hidden" type="file" id="cover-file" accept="image/*" />
        <button class="rounded-xl border border-white/10 px-4 py-2 text-sm text-slate-200" type="button" id="cover-pick">Pick</button>
        <button class="rounded-xl border border-amber-400/30 bg-amber-400/10 px-4 py-2 text-sm text-amber-300" type="button" id="cover-upload">Upload</button>
      </div>
      <label class="flex cursor-pointer items-center gap-2 rounded-xl bg-slate-800/50 px-4 py-2">
        <input type="checkbox" id="f-pinned" name="pinned" class="accent-amber-400" />
        <span class="text-sm text-slate-300">Pinned</span>
      </label>
      <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-2">
        <input type="checkbox" id="f-affiliate" name="affiliate" class="accent-emerald-400" />
        <span class="text-sm text-emerald-300">Affiliate Post</span>
      </label>
    </div>

    <input type="hidden" id="f-editor-mode" name="editorMode" value="wysiwyg" />

    <!-- The Editor Container -->
    <div class="editor-wrap">
      <div class="editor-header">
        <div class="editor-meta">
          <span class="text-sm font-medium text-slate-300">Article Content</span>
          <span id="editor-state" class="editor-state">当前：可视化编辑</span>
        </div>
        <div class="editor-mode-tags">
          <button type="button" class="mode-tag active" id="mode-wysiwyg">可视化</button>
          <button type="button" class="mode-tag" id="mode-markdown">Markdown 源码</button>
          <button type="button" class="mode-tag" id="mode-sv">Markdown + 预览</button>
          <button type="button" id="btn-insert-product" class="ml-4 rounded border border-amber-400/30 bg-amber-400/20 px-2 py-1 text-xs text-amber-300 hover:bg-amber-400/30">+ Product</button>
        </div>
      </div>
      <div id="vditor"></div>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <button class="rounded-xl bg-amber-400 px-8 py-3 font-bold text-slate-950 shadow-lg shadow-amber-400/20 transition active:scale-95" type="submit" id="save-btn">Save Content</button>
      <button class="rounded-xl border border-white/10 px-6 py-3 text-sm text-slate-300" type="button" id="save-draft-btn">Save as Draft</button>
      <span id="msg" class="text-sm italic"></span>
    </div>
  </form>

  <section id="revisions-panel" class="mt-8 hidden space-y-3">
    <h3 class="text-sm font-bold uppercase tracking-widest text-slate-200">Revision History</h3>
    <div id="revisions-list" class="grid gap-2"></div>
  </section>

  <!-- Vditor JS -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/vditor@3.10.7/dist/index.min.js"></script>

  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const slug = new URL(location.href).searchParams.get('slug');
      const modeMeta = {
        wysiwyg: '可视化编辑',
        markdown: 'Markdown 源码模式',
        sv: 'Markdown 分栏预览',
      };
      const sanitizeMode = (value) => {
        if (value === 'ir') return 'markdown';
        return value === 'markdown' || value === 'sv' || value === 'wysiwyg' ? value : 'wysiwyg';
      };
      const persistedMode = (() => {
        try {
          return sanitizeMode(localStorage.getItem('admin-post-editor-mode'));
        } catch {
          return 'wysiwyg';
        }
      })();

      let vditor = null;
      let isSaving = false;
      let isDirty = false;
      let currentEditorMode = persistedMode;

      const form = $('form');
      const msg = $('msg');
      const editorState = $('editor-state');
      const editorModeInput = $('f-editor-mode');

      function setMessage(text, tone = 'info') {
        msg.textContent = text;
        msg.className = tone === 'error'
          ? 'text-sm italic text-rose-400'
          : tone === 'success'
            ? 'text-sm italic text-emerald-400'
            : 'text-sm italic text-amber-400';
      }

      function rememberMode(mode) {
        try {
          localStorage.setItem('admin-post-editor-mode', mode);
        } catch {
          // ignore storage errors
        }
      }

      function markDirty() {
        if (isSaving) return;
        isDirty = true;
      }

      function applyEditorLayout(mode) {
        const editorRoot = $('vditor');
        if (!editorRoot) return;
        editorRoot.classList.toggle('editor-mode-markdown', sanitizeMode(mode) === 'markdown');
      }

      function updateModeUi(mode, options = {}) {
        const nextMode = sanitizeMode(mode);
        const { dirty = false } = options;
        const modeChanged = currentEditorMode !== nextMode;
        currentEditorMode = nextMode;
        if (editorModeInput) editorModeInput.value = nextMode;
        if (editorState) editorState.textContent = `当前：${modeMeta[nextMode]}`;
        document.querySelectorAll('.mode-tag').forEach((tag) => {
          tag.classList.toggle('active', tag.id === `mode-${nextMode}`);
        });
        applyEditorLayout(nextMode);
        rememberMode(nextMode);
        if (dirty && modeChanged) {
          markDirty();
        }
      }

      function readBuiltinEditorMode(fallback = 'wysiwyg') {
        return vditor?.currentMode === 'sv' || vditor?.currentMode === 'wysiwyg' ? vditor.currentMode : fallback;
      }

      function readEditorCurrentMode(fallback = currentEditorMode) {
        return sanitizeMode(fallback);
      }

      function getBuiltinModeButton(mode) {
        const builtinMode = sanitizeMode(mode) === 'markdown' ? 'sv' : sanitizeMode(mode);
        return vditor?.toolbar?.elements?.['edit-mode']?.querySelector(`button[data-mode="${builtinMode}"]`);
      }

      function bindBuiltinModeSync() {
        const editMode = vditor?.toolbar?.elements?.['edit-mode'];
        if (!editMode) return;
        editMode.style.display = 'none';
      }

      function setMode(mode, options = {}) {
        const nextMode = sanitizeMode(mode);
        const builtinMode = nextMode === 'markdown' ? 'sv' : nextMode;
        const { syncEditor = true, dirty = syncEditor } = options;
        if (syncEditor && vditor) {
          const currentMode = readBuiltinEditorMode();
          if (currentMode !== builtinMode) {
            const switchButton = getBuiltinModeButton(nextMode);
            if (switchButton) {
              switchButton.click();
            } else {
              console.warn('Vditor edit-mode button not found:', nextMode);
            }
          }
          window.requestAnimationFrame(() => {
            updateModeUi(nextMode, { dirty });
          });
          return;
        }
        updateModeUi(nextMode, { dirty });
      }

      setMode(currentEditorMode, { syncEditor: false, dirty: false });

      // 1. Initialize Vditor
      vditor = new Vditor('vditor', {
        height: 600,
        mode: currentEditorMode === 'markdown' ? 'sv' : currentEditorMode,
        theme: 'classic',
        cdn: 'https://cdn.jsdelivr.net/npm/vditor@3.10.7',
        toolbarConfig: {
          pin: true,
        },
        cache: {
          enable: false,
        },
        toolbar: [
          'emoji', 'headings', 'bold', 'italic', 'strike', 'link', '|',
          'list', 'ordered-list', 'check', 'outdent', 'indent', '|',
          'quote', 'line', 'code', 'inline-code', 'insert-before', 'insert-after', '|',
          'upload', 'table', '|',
          'undo', 'redo', '|',
          'fullscreen', 'edit-mode'
        ],
        upload: {
          url: '/api/admin/upload-image',
          fieldName: 'file',
          linkToImgUrl: '/api/admin/upload-image',
          handler(file) {
            return null;
          }
        },
        input() {
          markDirty();
        },
        after() {
          bindBuiltinModeSync();
          setMode(currentEditorMode, { dirty: false });
          if (slug) loadPost();
        }
      });

      // Mode switch handling
      $('mode-wysiwyg').onclick = () => setMode('wysiwyg');
      $('mode-markdown').onclick = () => setMode('markdown');
      $('mode-sv').onclick = () => setMode('sv');

      // 2. Load Existing Post
      async function loadPost() {
        $('page-heading').textContent = 'Edit Content';
        try {
          const resp = await fetch(`/api/admin/posts/${encodeURIComponent(slug)}`);
          if (!resp.ok) {
            setMessage(`Load failed: ${await resp.text()}`, 'error');
            return;
          }
          const post = await resp.json();

          $('f-title').value = post.title || '';
          $('f-slug').value = post.slug || '';
          $('f-tags').value = (post.tags || []).join(', ');
          $('f-status').value = post.status || 'published';
          $('f-cover').value = post.coverImage || '';
          $('f-pinned').checked = !!post.pinned;
          $('f-affiliate').checked = !!post.affiliate;

          $('f-price').value = post.customData?.price || '';
          $('f-affLink').value = post.customData?.affiliateLink || '';
          $('f-heroImg').value = post.customData?.heroImage || '';

          vditor.setValue(post.content || '');
          setMode(post.editorMode || currentEditorMode, { dirty: false });
          isDirty = false;
          loadRevisions();
        } catch (e) {
          console.error(e);
          setMessage('Load failed because of a client error.', 'error');
        }
      }

      // 2.1 Get Global Settings to decide UI
      async function initUi() {
        const resp = await fetch('/api/admin/settings');
        if (resp.ok) {
          const settings = await resp.json();
          if (settings.templates?.home === 'imoo' || settings.templates?.post === 'imoo') {
            $('custom-data-panel').classList.remove('hidden');
          }
        }
      }
      initUi();

      async function loadRevisions() {
        const resp = await fetch(`/api/admin/posts/${encodeURIComponent(slug)}/revisions`);
        if (!resp.ok) return;
        const data = await resp.json();
        const revisions = data.revisions || [];
        if (revisions.length > 0) {
          $('revisions-panel').classList.remove('hidden');
          $('revisions-list').innerHTML = revisions.map(path => {
            const name = path.split('/').pop();
            return `
              <div class="flex items-center justify-between rounded-xl border border-white/5 bg-slate-900/50 p-3">
                <span class="font-mono text-xs text-slate-400">${name}</span>
                <button type="button" class="text-xs text-amber-400 hover:underline" onclick="restoreRevision('${encodeURIComponent(path)}')">Restore</button>
              </div>`;
          }).join('');
        }
      }

      window.restoreRevision = async (path) => {
        if (!confirm('Replace current content with this version?')) return;
        const resp = await fetch(`/api/admin/posts/${encodeURIComponent(slug)}/revisions`, {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ revisionPath: decodeURIComponent(path) })
        });
        if (resp.ok) location.reload();
      };

      form.addEventListener('input', markDirty);
      window.addEventListener('beforeunload', (event) => {
        if (!isDirty || isSaving) return;
        event.preventDefault();
        event.returnValue = '';
      });

      // 3. Save Handling
      form.onsubmit = async (e) => {
        e.preventDefault();
        save('published');
      };

      $('save-draft-btn').onclick = () => save('draft');

      async function save(forceStatus) {
        if (isSaving) return;
        isSaving = true;
        const status = forceStatus || $('f-status').value;
        setMessage('Saving...', 'info');

        const payload = {
          title: $('f-title').value,
          slug: $('f-slug').value,
          description: '',
          tags: $('f-tags').value.split(',').map(t => t.trim()).filter(Boolean),
          status,
          pinned: $('f-pinned').checked,
          affiliate: $('f-affiliate').checked,
          customData: {
            price: $('f-price').value,
            affiliateLink: $('f-affLink').value,
            heroImage: $('f-heroImg').value
          },
          coverImage: $('f-cover').value,
          editorMode: currentEditorMode,
          content: vditor.getValue()
        };

        const url = slug ? `/api/admin/posts/${encodeURIComponent(slug)}` : '/api/admin/posts';
        const method = slug ? 'PUT' : 'POST';

        try {
          const resp = await fetch(url, {
            method,
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(payload)
          });
          if (resp.ok) {
            const data = await resp.json();
            setMessage('Saved successfully ✓', 'success');
            isDirty = false;
            if (data.slug && data.slug !== slug) {
              location.href = `/admin/posts/new?slug=${encodeURIComponent(data.slug)}`;
            }
          } else {
            setMessage('Error: ' + await resp.text(), 'error');
          }
        } catch (e) {
          setMessage('System error occurred.', 'error');
        } finally {
          isSaving = false;
        }
      }

      // 4. Image Upload (Cover)
      const coverFile = $('cover-file');
      $('cover-pick').onclick = () => coverFile.click();
      $('cover-upload').onclick = async () => {
        const file = coverFile.files[0];
        if (!file) return alert('Select a file first');
        const fd = new FormData();
        fd.append('file', file);
        try {
          const resp = await fetch('/api/admin/upload-image', {method: 'POST', body: fd});
          const data = await resp.json();
          if (data.url) {
            $('f-cover').value = data.url;
            markDirty();
          }
        } catch (e) {
          alert('Upload failed');
        }
      };

      // Auto slug
      $('f-title').oninput = () => {
        if (!slug) $('f-slug').value = $('f-title').value.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fa5]+/g, '-').replace(/^-+|-+$/g, '');
      };

      $('btn-insert-product').onclick = () => {
        const template = '[product title="Product Name" price="$99.00" image="https://example.com/img.jpg" link="https://amazon.com/dp/..." desc="Key features and why you should buy it." label="View on Amazon"]';
        vditor.insertValue(template);
        markDirty();
      };
    })();
  </script>
</AdminLayout>
