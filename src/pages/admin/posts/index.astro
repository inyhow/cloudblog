---
import SiteLayout from '../../../layouts/SiteLayout.astro';
---

<SiteLayout title="文章管理">
  <h1 class="mb-4 text-2xl font-bold">文章管理</h1>
  <div class="mb-4 flex gap-3">
    <a class="rounded bg-slate-900 px-3 py-2 text-white" href="/admin/posts/new">新建文章</a>
    <a class="rounded border px-3 py-2" href="/admin/settings">网站设置</a>
  </div>
  <div id="list" class="grid gap-3"></div>
  <script is:inline>
    const list = document.getElementById('list');
    const resp = await fetch('/api/admin/posts');
    if (resp.status === 401) location.href = '/admin';
    const posts = await resp.json();
    list.innerHTML = posts.map((p) => `
      <a class="rounded-lg border border-slate-200 bg-white p-4" href="/admin/posts/new?slug=${p.slug}">
        <div class="text-lg font-semibold">${p.title}</div>
        <div class="text-sm text-slate-500">${p.description || ''}</div>
      </a>
    `).join('');
  </script>
</SiteLayout>
