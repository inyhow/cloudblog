---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Articles">
  <div class="mb-6 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold text-white">Articles</h1>
      <p class="mt-2 text-sm text-slate-300">Core workflow first. Advanced tools are collapsed.</p>
    </div>
    <div class="flex gap-3">
      <a class="rounded-xl bg-amber-400 px-4 py-2 font-medium text-slate-950" href="/admin/posts/new">New Post</a>
      <a class="rounded-xl border border-white/10 px-4 py-2 text-slate-200" href="/admin/pages/new">New Page</a>
    </div>
  </div>

  <div id="tabs" class="mb-4 flex flex-wrap gap-2">
    <button data-tab="all" class="rounded-xl border border-white/10 px-3 py-2 text-sm">All</button>
    <button data-tab="draft" class="rounded-xl border border-white/10 px-3 py-2 text-sm">Draft</button>
    <button data-tab="review" class="rounded-xl border border-white/10 px-3 py-2 text-sm">Review</button>
    <button data-tab="scheduled" class="rounded-xl border border-white/10 px-3 py-2 text-sm">Scheduled</button>
    <button data-tab="published" class="rounded-xl border border-white/10 px-3 py-2 text-sm">Published</button>
    <button data-tab="deleted" class="rounded-xl border border-white/10 px-3 py-2 text-sm">Recycle Bin</button>
  </div>

  <details class="mb-4 rounded-xl border border-white/10 bg-slate-900/50 p-3 text-sm">
    <summary class="cursor-pointer">Advanced Bulk Actions</summary>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <label class="flex items-center gap-2"><input id="select-all" type="checkbox" /> <span>Select all in tab</span></label>
      <button id="batch-publish" class="rounded-lg border border-emerald-400/50 px-3 py-1 text-emerald-300" type="button">Batch Publish</button>
      <button id="batch-draft" class="rounded-lg border border-slate-400/50 px-3 py-1 text-slate-300" type="button">Batch Draft</button>
      <button id="batch-delete" class="rounded-lg border border-red-400/50 px-3 py-1 text-red-300" type="button">Batch Recycle</button>
    </div>
  </details>

  <div id="list" class="grid gap-3"></div>
  <p id="msg" class="mt-3 text-sm text-red-300"></p>

  <script is:inline>
    (() => {
      const list = document.getElementById('list');
      const msg = document.getElementById('msg');
      const tabs = document.getElementById('tabs');
      const selectAll = document.getElementById('select-all');
      let activeTab = 'all';
      let posts = [];
      let selected = new Set();

      function badgeTone(status) {
        if (status === 'published') return 'bg-emerald-500/15 text-emerald-300';
        if (status === 'draft') return 'bg-slate-500/20 text-slate-300';
        if (status === 'review') return 'bg-sky-500/20 text-sky-300';
        if (status === 'scheduled') return 'bg-violet-500/20 text-violet-300';
        if (status === 'deleted') return 'bg-rose-500/20 text-rose-300';
        return 'bg-amber-500/20 text-amber-300';
      }

      function editorModeTone(mode) {
        if (mode === 'wysiwyg') return 'bg-amber-500/15 text-amber-200';
        if (mode === 'sv') return 'bg-indigo-500/15 text-indigo-200';
        return 'bg-cyan-500/15 text-cyan-200';
      }

      function editorModeLabel(mode) {
        if (mode === 'wysiwyg') return '可视化';
        if (mode === 'sv') return 'Markdown + 预览';
        return 'Markdown';
      }

      function filteredPosts() {
        if (activeTab === 'all') return posts;
        return posts.filter((post) => post.status === activeTab);
      }

      function switchTab(tab) {
        activeTab = tab;
        selected = new Set();
        if (selectAll) selectAll.checked = false;
        tabs.querySelectorAll('[data-tab]').forEach((button) => {
          const current = button.dataset.tab === tab;
          button.classList.toggle('bg-amber-400', current);
          button.classList.toggle('text-slate-950', current);
        });
        render();
      }

      async function updateStatus(slug, status, reviewNote = undefined) {
        const post = posts.find((item) => item.slug === slug);
        if (!post) return false;
        const payload = { ...post, status };
        if (typeof reviewNote === 'string') payload.reviewNote = reviewNote;
        const resp = await fetch(`/api/admin/posts/${encodeURIComponent(slug)}`, {
          method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload),
        });
        if (!resp.ok) {
          msg.textContent = `Update failed for ${slug}: ${await resp.text()}`;
          return false;
        }
        return true;
      }

      async function softDelete(slug) {
        const resp = await fetch(`/api/admin/posts/${encodeURIComponent(slug)}`, { method: 'DELETE' });
        if (!resp.ok) {
          msg.textContent = `Delete failed for ${slug}: ${await resp.text()}`;
          return false;
        }
        return true;
      }

      async function refresh() {
        const resp = await fetch('/api/admin/posts');
        if (resp.status === 401) return (location.href = '/admin');
        const raw = await resp.text();
        if (!resp.ok) return (msg.textContent = raw);
        posts = JSON.parse(raw).sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());
        render();
      }

      async function runBatch(kind) {
        const slugs = Array.from(selected);
        if (!slugs.length) return (msg.textContent = 'Please select at least one post.');
        for (const slug of slugs) {
          if (kind === 'publish') await updateStatus(slug, 'published');
          if (kind === 'draft') await updateStatus(slug, 'draft');
          if (kind === 'delete') await softDelete(slug);
        }
        selected = new Set();
        if (selectAll) selectAll.checked = false;
        await refresh();
        msg.textContent = 'Batch action complete.';
      }

      function render() {
        const visible = filteredPosts();
        if (!visible.length) return (list.innerHTML = '<div class="rounded-xl border border-white/10 bg-slate-900/50 p-4 text-sm text-slate-300">No posts in this tab.</div>');

        list.innerHTML = visible.map((p) => `
          <article class="rounded-2xl border border-white/10 bg-slate-900/60 p-5 transition hover:border-amber-400/40">
            <div class="mb-3 flex items-start gap-3">
              <input data-select-slug="${encodeURIComponent(p.slug)}" type="checkbox" ${selected.has(p.slug) ? 'checked' : ''} />
              <div class="min-w-0 flex-1">
                <a class="block" href="/admin/posts/new?slug=${encodeURIComponent(p.slug)}">
                  <div class="mb-2 flex flex-wrap items-center gap-2">
                    <div class="text-lg font-semibold text-white">${p.title}</div>
                    <span class="rounded-full px-2 py-0.5 text-xs ${badgeTone(p.status)}">${p.status}</span>
                    <span class="rounded-full px-2 py-0.5 text-xs ${editorModeTone(p.editorMode)}">${editorModeLabel(p.editorMode)}</span>
                  </div>
                  <div class="text-sm text-slate-300">${p.description || ''}</div>
                  <div class="mt-2 text-xs text-slate-400">/${p.slug}</div>
                </a>
              </div>
            </div>
            <div class="mt-4 flex flex-wrap justify-end gap-2">
              <a href="/admin/posts/new?slug=${encodeURIComponent(p.slug)}" class="rounded-lg border border-white/20 px-3 py-1.5 text-xs text-slate-200">Edit</a>
              ${p.status === 'review' ? '<button data-action="approve" data-slug="' + encodeURIComponent(p.slug) + '" class="rounded-lg border border-emerald-400/50 px-3 py-1.5 text-xs text-emerald-300" type="button">Approve</button>' : ''}
              ${p.status === 'review' ? '<button data-action="reject" data-slug="' + encodeURIComponent(p.slug) + '" class="rounded-lg border border-sky-400/50 px-3 py-1.5 text-xs text-sky-300" type="button">Reject</button>' : ''}
              ${p.status === 'deleted' ? '<button data-action="restore" data-slug="' + encodeURIComponent(p.slug) + '" class="rounded-lg border border-emerald-400/50 px-3 py-1.5 text-xs text-emerald-300" type="button">Restore</button>' : ''}
              <button data-action="publish" data-slug="${encodeURIComponent(p.slug)}" class="rounded-lg border border-emerald-400/50 px-3 py-1.5 text-xs text-emerald-300" type="button">Publish</button>
              <button data-action="delete" data-slug="${encodeURIComponent(p.slug)}" class="rounded-lg border border-red-400/50 px-3 py-1.5 text-xs text-red-300" type="button">Recycle</button>
            </div>
          </article>
        `).join('');

        list.querySelectorAll('[data-select-slug]').forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            const slug = decodeURIComponent(checkbox.dataset.selectSlug);
            checkbox.checked ? selected.add(slug) : selected.delete(slug);
          });
        });

        list.querySelectorAll('[data-action]').forEach((button) => {
          button.addEventListener('click', async (event) => {
            event.preventDefault();
            event.stopPropagation();
            const action = button.dataset.action;
            const slug = decodeURIComponent(button.dataset.slug);
            if (action === 'delete') return (await softDelete(slug)) && refresh();
            if (action === 'approve') return (await updateStatus(slug, 'published', 'Approved')) && refresh();
            if (action === 'reject') {
              const note = prompt('Rejection note', 'Need revision') || 'Need revision';
              return (await updateStatus(slug, 'draft', note)) && refresh();
            }
            const nextStatus = action === 'publish' ? 'published' : 'draft';
            (await updateStatus(slug, nextStatus)) && refresh();
          });
        });
      }

      tabs.querySelectorAll('[data-tab]').forEach((button) => button.addEventListener('click', () => switchTab(button.dataset.tab)));
      if (selectAll) {
        selectAll.addEventListener('change', () => {
          const visible = filteredPosts();
          if (selectAll.checked) visible.forEach((p) => selected.add(p.slug));
          else visible.forEach((p) => selected.delete(p.slug));
          render();
        });
      }
      document.getElementById('batch-publish')?.addEventListener('click', () => runBatch('publish'));
      document.getElementById('batch-draft')?.addEventListener('click', () => runBatch('draft'));
      document.getElementById('batch-delete')?.addEventListener('click', () => runBatch('delete'));

      switchTab('all');
      refresh();
    })();
  </script>
</AdminLayout>
