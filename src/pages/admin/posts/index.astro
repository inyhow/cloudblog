---
import SiteLayout from '../../../layouts/SiteLayout.astro';
---

<SiteLayout title="文章管理">
  <h1 class="mb-4 text-2xl font-bold">文章管理</h1>
  <div class="mb-4 flex gap-3">
    <a class="rounded bg-slate-900 px-3 py-2 text-white" href="/admin/posts/new">新建文章</a>
    <a class="rounded border px-3 py-2" href="/admin/settings">网站设置</a>
  </div>
  <div id="list" class="grid gap-3"></div>
  <p id="msg" class="mt-2 text-sm text-red-600"></p>
  <script is:inline>
    (() => {
      const list = document.getElementById('list');
      const msg = document.getElementById('msg');
      (async () => {
        const resp = await fetch('/api/admin/posts');
        if (resp.status === 401) {
          location.href = '/admin';
          return;
        }
        const raw = await resp.text();
        if (!resp.ok) {
          msg.textContent = raw;
          return;
        }
        const posts = JSON.parse(raw);
        posts.sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());
        list.innerHTML = posts
          .map(
            (p) => `
          <a class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm" href="/admin/posts/new?slug=${encodeURIComponent(p.slug)}">
            <div class="mb-1 flex items-center gap-2">
              <div class="text-lg font-semibold">${p.title}</div>
              <span class="rounded px-2 py-0.5 text-xs ${p.status === 'published' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-600'}">${p.status}</span>
              ${p.pinned ? '<span class="rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-700">pinned</span>' : ''}
            </div>
            <div class="text-sm text-slate-500">${p.description || ''}</div>
            <div class="mt-1 text-xs text-slate-400">/${p.slug}</div>
            <div class="mt-2 text-xs text-slate-400">${new Date(p.pubDate).toLocaleString('zh-CN')}</div>
          </a>
        `,
          )
          .join('');
      })();
    })();
  </script>
</SiteLayout>
