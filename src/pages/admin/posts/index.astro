---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Articles">
  <div class="mb-6 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold text-white">Articles</h1>
      <p class="mt-2 text-sm text-slate-300">Manage published posts, drafts, pinned content, and custom slugs.</p>
    </div>
    <div class="flex gap-3">
      <a class="rounded-xl bg-amber-400 px-4 py-2 font-medium text-slate-950" href="/admin/posts/new">New Post</a>
      <a class="rounded-xl border border-white/10 px-4 py-2 text-slate-200" href="/admin/settings">Template Center</a>
    </div>
  </div>
  <div id="list" class="grid gap-3"></div>
  <p id="msg" class="mt-3 text-sm text-red-300"></p>
  <script is:inline>
    (() => {
      const list = document.getElementById('list');
      const msg = document.getElementById('msg');
      (async () => {
        const resp = await fetch('/api/admin/posts');
        if (resp.status === 401) {
          location.href = '/admin';
          return;
        }
        const raw = await resp.text();
        if (!resp.ok) {
          msg.textContent = raw;
          return;
        }
        const posts = JSON.parse(raw);
        posts.sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());
        list.innerHTML = posts
          .map(
            (p) => `
              <a class="rounded-2xl border border-white/10 bg-slate-900/60 p-5 transition hover:border-amber-400/40" href="/admin/posts/new?slug=${encodeURIComponent(p.slug)}">
                <div class="mb-2 flex flex-wrap items-center gap-2">
                  <div class="text-lg font-semibold text-white">${p.title}</div>
                  <span class="rounded-full px-2 py-0.5 text-xs ${p.status === 'published' ? 'bg-emerald-500/15 text-emerald-300' : 'bg-slate-500/15 text-slate-300'}">${p.status}</span>
                  ${p.pinned ? '<span class="rounded-full bg-amber-400/15 px-2 py-0.5 text-xs text-amber-300">pinned</span>' : ''}
                </div>
                <div class="text-sm text-slate-300">${p.description || ''}</div>
                <div class="mt-2 text-xs text-slate-400">/${p.slug}</div>
                <div class="mt-2 text-xs text-slate-500">${new Date(p.pubDate).toLocaleString('zh-CN')}</div>
              </a>
            `,
          )
          .join('');
      })();
    })();
  </script>
</AdminLayout>
