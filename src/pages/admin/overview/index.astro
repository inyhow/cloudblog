---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Overview">
  <div class="mb-6">
    <h1 class="text-3xl font-semibold text-white">Overview</h1>
    <p class="mt-2 text-sm text-slate-300">Core KPI board.</p>
  </div>
  <div id="cards" class="grid gap-3 md:grid-cols-4"></div>

  <script is:inline>
    (() => {
      const cards = document.getElementById('cards');

      (async () => {
        const resp = await fetch('/api/admin/posts');
        if (resp.status === 401) {
          location.href = '/admin';
          return;
        }
        const posts = await resp.json();

        const stat = [
          { label: 'All Posts', value: posts.length },
          { label: 'Review Queue', value: posts.filter((p) => p.status === 'review').length },
          { label: 'Drafts', value: posts.filter((p) => p.status === 'draft').length },
          { label: 'Published', value: posts.filter((p) => p.status === 'published').length },
        ];

        cards.innerHTML = stat
          .map(
            (s) => `<div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4"><div class="text-xs uppercase tracking-[0.2em] text-slate-400">${s.label}</div><div class="mt-2 text-3xl font-semibold text-white">${s.value}</div></div>`,
          )
          .join('');
      })();
    })();
  </script>
</AdminLayout>
