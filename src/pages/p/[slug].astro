---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getRuntimeEnv } from '../../lib/runtime-env';
import { getCustomPageBySlug } from '../../lib/custom-pages';
import { readSettings } from '../../lib/settings';
import { renderTemplateVariables } from '../../lib/template-vars';

const slug = Astro.params.slug!;
const runtimeEnv = getRuntimeEnv(Astro.locals);
const settings = await readSettings(runtimeEnv);
const page = await getCustomPageBySlug(slug, runtimeEnv);
if (!page) {
  return Astro.redirect('/');
}

const pageHeaderRaw = settings.templateContent?.pageHeaderHtml || '';
const pageHeaderHtml = renderTemplateVariables(pageHeaderRaw, {
  site: { title: settings.title, description: settings.description, footer: settings.footer, menuHtml: '' },
  post: { title: page.title, description: page.description, content: page.content, pubDate: '', category: 'Page', tags: [], coverImage: '', price: '', affiliateLink: '', heroImage: '' },
  variables: settings.templateVariables
});
---

<SiteLayout title={page.title} description={page.description}>
  {pageHeaderHtml && <div class="mb-4" set:html={pageHeaderHtml} />}
  <article class:list={["prose max-w-none rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7"]}>
    <h1>{page.title}</h1>
    <div set:html={page.content} />
  </article>
</SiteLayout>
