---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LPImooLayout from '../../layouts/LPImooLayout.astro';
import { getRuntimeEnv } from '../../lib/runtime-env';
import { getCustomPageBySlug } from '../../lib/custom-pages';
import { readSettings } from '../../lib/settings';
import { getTemplateFile } from '../../lib/template-files';
import { renderTemplateVariables } from '../../lib/template-vars';

const slug = Astro.params.slug!;
const runtimeEnv = getRuntimeEnv(Astro.locals);
const settings = await readSettings(runtimeEnv);
const page = await getCustomPageBySlug(slug, runtimeEnv);
if (!page) {
  return Astro.redirect('/');
}
const pageTemplate = page.template || settings.templates?.page || 'classic';
const pageFile = await getTemplateFile('page', runtimeEnv);
const pageHeaderRaw = pageFile?.content || settings.templateContent?.pageHeaderHtml || '';
const pageHeaderHtml = renderTemplateVariables(pageHeaderRaw, {
  'site.title': settings.title,
  'page.title': page.title,
  'page.description': page.description,
  ...settings.templateVariables,
});

// Layout Logic
const isLPImoo = pageTemplate === 'imoo';
---

{isLPImoo ? (
  <LPImooLayout 
    title={page.title} 
    description={page.description} 
    content={page.content} 
    customData={page.customData} 
  />
) : (
  <SiteLayout title={page.title} description={page.description}>
    {pageHeaderHtml && <div class="mb-4" set:html={pageHeaderHtml} />}
    <article class:list={["prose max-w-none rounded-lg border border-slate-200 bg-white", pageTemplate === 'minimal' ? 'p-4' : 'p-6']}>
      <h1>{page.title}</h1>
      <div set:html={page.content} />
    </article>
  </SiteLayout>
)}
