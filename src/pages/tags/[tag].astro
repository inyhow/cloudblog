---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { listPosts } from '../../lib/posts';
import { getRuntimeEnv } from '../../lib/runtime-env';
import { readSettings } from '../../lib/settings';
import { getTemplateFile } from '../../lib/template-files';

const tag = decodeURIComponent(Astro.params.tag!);
const runtimeEnv = getRuntimeEnv(Astro.locals);
const settings = await readSettings(runtimeEnv);
const tagTemplate = settings.templates?.tag ?? 'classic';
const tagFile = await getTemplateFile('tag', runtimeEnv);
const tagHeaderHtml = tagFile?.content || settings.templateContent?.tagHeaderHtml || '';
const posts = (await listPosts(runtimeEnv))
  .filter((post) => post.status === 'published' && post.tags.includes(tag))
  .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());
---

<SiteLayout title={`Tag: ${tag}`} description={`Posts tagged ${tag}`}>
  {tagHeaderHtml && <div class="mb-4" set:html={tagHeaderHtml} />}
  <section class="mb-8 flex items-end justify-between gap-4">
    <div>
      <p class="mb-2 text-xs uppercase tracking-[0.24em] text-slate-400">Tag Archive</p>
      <h1 class="text-3xl font-black tracking-tight text-slate-950">#{tag}</h1>
    </div>
    <p class="text-sm text-slate-500">{posts.length} matching posts</p>
  </section>
  <div class:list={["grid gap-4", tagTemplate === 'grid' ? 'md:grid-cols-2' : 'md:grid-cols-3', tagTemplate === 'minimal' ? 'gap-3 md:grid-cols-1' : '']}>
    {posts.map((post) => (
      <a href={`/blog/${post.slug}`} class:list={["rounded-[1.5rem] border border-slate-200 bg-white transition hover:-translate-y-1 hover:shadow-xl", tagTemplate === 'minimal' ? 'p-4' : 'overflow-hidden']}>
        {tagTemplate !== 'minimal' && post.coverImage && <img class="h-44 w-full object-cover" src={post.coverImage} alt={post.title} />}
        <div class:list={[tagTemplate === 'minimal' ? '' : 'p-5']}>
          <h2 class="text-lg font-semibold text-slate-950">{post.title}</h2>
          <p class="mt-2 text-slate-600">{post.description}</p>
          <p class="mt-3 text-xs uppercase tracking-[0.22em] text-slate-400">{new Date(post.pubDate).toLocaleDateString('zh-CN')}</p>
        </div>
      </a>
    ))}
  </div>
</SiteLayout>
