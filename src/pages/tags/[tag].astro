---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { listPosts } from '../../lib/posts';

const tag = decodeURIComponent(Astro.params.tag!);
const posts = (await listPosts()).filter((post) => post.tags.includes(tag));
---

<SiteLayout title={`标签: ${tag}`}>
  <h1 class="mb-6 text-2xl font-bold">标签: {tag}</h1>
  <div class="grid gap-4">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}`} class="rounded-lg border border-slate-200 bg-white p-4 transition hover:shadow">
        <h2 class="text-lg font-semibold">{post.title}</h2>
        <p class="text-slate-600">{post.description}</p>
      </a>
    ))}
  </div>
</SiteLayout>
