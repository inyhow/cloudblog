---
import SiteLayout from '../layouts/SiteLayout.astro';
import { listPosts } from '../lib/posts';
import { readSettings } from '../lib/settings';

const settings = await readSettings();
const posts = await listPosts();
---

<SiteLayout title={settings.title} description={settings.description}>
  <section class="mb-8">
    <h1 class="mb-2 text-3xl font-bold">{settings.title}</h1>
    <p class="text-slate-600">{settings.description}</p>
  </section>
  <section class="grid gap-4">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}`} class="rounded-lg border border-slate-200 bg-white p-4 transition hover:shadow">
        <h2 class="text-xl font-semibold">{post.title}</h2>
        <p class="mt-1 text-slate-600">{post.description}</p>
        <div class="mt-3 flex gap-2 text-xs text-slate-500">
          {post.tags.map((tag) => <span>#{tag}</span>)}
        </div>
      </a>
    ))}
  </section>
</SiteLayout>
