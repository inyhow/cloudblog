---
import SiteLayout from '../layouts/SiteLayout.astro';
import { isPostPublic, listPosts } from '../lib/posts';
import { readSettings } from '../lib/settings';
import { getRuntimeEnv } from '../lib/runtime-env';

const runtimeEnv = getRuntimeEnv(Astro.locals);
const settings = await readSettings(runtimeEnv);
const homeTitle = settings.seo?.homeTitle || settings.title;
const homeDescription = settings.seo?.homeDescription || settings.description;
const homeTemplate = settings.templates?.home ?? 'classic';

const posts = (await listPosts(runtimeEnv))
  .filter((post) => isPostPublic(post))
  .sort((a, b) => {
    if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;
    return new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf();
  });

const featured = posts[0];
const homeList = homeTemplate === 'minimal' ? posts.slice(0, 8) : posts.slice(1, 7);
const remainingCount = Math.max(posts.length - (homeTemplate === 'minimal' ? homeList.length : homeList.length + (featured ? 1 : 0)), 0);
const tagBuckets = new Map<string, typeof posts>();
for (const post of posts) {
  for (const rawTag of post.tags || []) {
    const tag = rawTag.trim();
    if (!tag) continue;
    const bucket = tagBuckets.get(tag) || [];
    if (!bucket.some((item) => item.slug === post.slug)) {
      bucket.push(post);
    }
    tagBuckets.set(tag, bucket);
  }
}
const tagSections = Array.from(tagBuckets.entries())
  .map(([tag, taggedPosts]) => ({
    tag,
    total: taggedPosts.length,
    posts: taggedPosts.slice(0, 4),
  }))
  .sort((a, b) => b.total - a.total || a.tag.localeCompare(b.tag))
  .slice(0, 6);
---

<SiteLayout title={homeTitle} description={homeDescription}>
  <section class="mb-8 overflow-hidden rounded-2xl border border-amber-200/60 bg-[linear-gradient(135deg,#fff7ed_0%,#ffffff_50%,#fffbeb_100%)] p-5 shadow-[0_20px_80px_-40px_rgba(245,158,11,0.45)] sm:p-8 md:mb-10">
    <div class="grid gap-6 md:grid-cols-[1.2fr_0.8fr] md:items-end lg:gap-8">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-amber-600">Cloudflare Pages CMS</p>
        <h1 class="max-w-3xl text-3xl font-black tracking-tight text-slate-950 sm:text-4xl md:text-6xl">{settings.title}</h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600 md:text-lg">{settings.description}</p>
      </div>
    </div>
  </section>

  {featured && homeTemplate !== 'minimal' && (
    <section class="mb-8 grid gap-5 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5 md:grid-cols-[1.2fr_0.8fr] md:gap-6">
      <a href={`/blog/${featured.slug}`} class="overflow-hidden rounded-[1.5rem]">
        {featured.coverImage ? (
          <img class="aspect-[16/10] w-full rounded-[1.5rem] object-cover md:h-full md:max-h-[26rem]" src={featured.coverImage} alt={featured.title} />
        ) : (
          <div class="grid min-h-48 place-items-center rounded-[1.5rem] bg-slate-900 text-slate-100 md:h-full md:min-h-[20rem]">Featured Story</div>
        )}
      </a>
      <div class="flex flex-col justify-between gap-5">
        <div>
          <div class="mb-3 flex items-center gap-2 text-xs uppercase tracking-[0.24em] text-slate-400">
            {featured.pinned && <span class="rounded-full bg-amber-100 px-2 py-1 text-amber-700">Pinned</span>}
            <span>{new Date(featured.pubDate).toLocaleDateString('zh-CN')}</span>
          </div>
          <a href={`/blog/${featured.slug}`} class="text-2xl font-black tracking-tight text-slate-950 sm:text-3xl">{featured.title}</a>
          <p class="mt-4 text-slate-600">{featured.description}</p>
        </div>
        <div class="flex flex-wrap gap-2 text-xs text-slate-500">
          {featured.tags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag)}`} class="rounded-full bg-slate-100 px-3 py-1 hover:bg-slate-200">#{tag}</a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-2xl font-black tracking-tight text-slate-950">最新文章</h2>
      <p class="text-sm text-slate-500">首页当前显示 {homeList.length} 篇，更多内容可进入完整列表页。</p>
    </div>
    <a class="w-fit rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-900 hover:text-slate-950" href="/blog">
      查看全部文章
    </a>
  </section>

  <section class:list={['grid', homeTemplate === 'minimal' ? 'gap-3' : 'gap-4', homeTemplate === 'magazine' ? 'md:grid-cols-2' : '', homeTemplate === 'minimal' ? '' : 'md:grid-cols-3']}>
    {homeList.map((post) => (
      <article class:list={["group rounded-[1.5rem] border border-slate-200 bg-white transition hover:-translate-y-1 hover:shadow-xl", homeTemplate === 'minimal' ? 'p-4' : 'overflow-hidden']}>
        {homeTemplate !== 'minimal' && post.coverImage && (
          <a href={`/blog/${post.slug}`} class="block overflow-hidden">
            <img class="h-48 w-full object-cover transition duration-500 group-hover:scale-[1.03]" src={post.coverImage} alt={post.title} />
          </a>
        )}
        <div class:list={[homeTemplate === 'minimal' ? '' : 'p-5']}>
          <div class="mb-3 flex items-center gap-2 text-xs uppercase tracking-[0.22em] text-slate-400">
            {post.pinned && <span class="rounded-full bg-amber-100 px-2 py-1 text-amber-700">Pinned</span>}
            <span>{new Date(post.pubDate).toLocaleDateString('zh-CN')}</span>
          </div>
          <h2 class="text-xl font-bold tracking-tight text-slate-950">
            <a class="transition hover:text-sky-700" href={`/blog/${post.slug}`}>{post.title}</a>
          </h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">{post.description}</p>
          <div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-500">
            {post.tags.map((tag) => (
              <a href={`/tags/${encodeURIComponent(tag)}`} class="rounded-full bg-slate-100 px-3 py-1 hover:bg-slate-200">#{tag}</a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </section>

  {remainingCount > 0 && (
    <p class="mt-4 text-sm text-slate-500">还有 {remainingCount} 篇文章未在首页展开显示，可在列表页分页查看。</p>
  )}

  {tagSections.length > 0 && (
    <section class="mt-10 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="text-xl font-bold text-slate-900">热门标签</h3>
          <p class="text-sm text-slate-500">首页下方不再重复展开文章卡片，改为按标签快速浏览。</p>
        </div>
        <a class="text-sm text-sky-700 hover:text-sky-900" href="/blog">前往文章列表</a>
      </div>
      <div class="flex flex-wrap gap-3">
        {tagSections.map((row) => (
          <a
            href={`/tags/${encodeURIComponent(row.tag)}`}
            class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-sky-200 hover:bg-sky-50 hover:text-sky-800"
          >
            <span>#{row.tag}</span>
            <span class="rounded-full bg-white px-2 py-0.5 text-xs text-slate-500">{row.total}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</SiteLayout>
