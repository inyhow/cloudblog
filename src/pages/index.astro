---
import SiteLayout from '../layouts/SiteLayout.astro';
import { listPosts } from '../lib/posts';
import { readSettings } from '../lib/settings';
import { getRuntimeEnv } from '../lib/runtime-env';

const runtimeEnv = getRuntimeEnv(Astro.locals);
const settings = await readSettings(runtimeEnv);
const homeTemplate = settings.templates?.home ?? 'classic';
const posts = (await listPosts(runtimeEnv))
  .filter((post) => post.status === 'published')
  .sort((a, b) => {
    if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;
    return new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf();
  });
---

<SiteLayout title={settings.title} description={settings.description}>
  <section class="mb-8">
    <h1 class="mb-2 text-3xl font-bold">{settings.title}</h1>
    <p class="text-slate-600">{settings.description}</p>
  </section>
  <section class:list={["grid gap-4", homeTemplate === 'magazine' ? 'md:grid-cols-2' : '', homeTemplate === 'minimal' ? 'gap-2' : '']}>
    {posts.map((post) => (
      <a href={`/blog/${post.slug}`} class:list={["rounded-lg border border-slate-200 bg-white transition hover:shadow", homeTemplate === 'minimal' ? 'p-3' : 'p-4']}>
        {post.coverImage && <img class="mb-3 h-44 w-full rounded object-cover" src={post.coverImage} alt={post.title} />}
        <div class="mb-2 flex items-center gap-2">
          {post.pinned && <span class="rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-700">置顶</span>}
          <h2 class="text-xl font-semibold">{post.title}</h2>
        </div>
        <p class="mt-1 text-slate-600">{post.description}</p>
        <p class="mt-2 text-xs text-slate-500">发布时间：{new Date(post.pubDate).toLocaleString('zh-CN')}</p>
        <div class="mt-3 flex gap-2 text-xs text-slate-500">
          {post.tags.map((tag) => <span>#{tag}</span>)}
        </div>
      </a>
    ))}
  </section>
</SiteLayout>
