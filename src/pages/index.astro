---
import SiteLayout from '../layouts/SiteLayout.astro';
import { isPostPublic, listPosts } from '../lib/posts';
import { readSettings } from '../lib/settings';
import { getRuntimeEnv } from '../lib/runtime-env';
import { getTemplateFile } from '../lib/template-files';
import { renderTemplateVariables, renderMenuAsHtml } from '../lib/template-vars';

const runtimeEnv = getRuntimeEnv(Astro.locals);
const settings = await readSettings(runtimeEnv);
const homeTitle = settings.seo?.homeTitle || settings.title;
const homeDescription = settings.seo?.homeDescription || settings.description;
const homeTemplate = settings.templates?.home ?? 'classic';
const isImoo = homeTemplate === 'imoo';

const posts = (await listPosts(runtimeEnv))
  .filter((post) => isPostPublic(post))
  .sort((a, b) => {
    if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;
    return new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf();
  });

const featured = posts[0];

// Handle imoo Template Rendering
if (isImoo) {
  const homeFile = await getTemplateFile('home', runtimeEnv);
  if (homeFile?.content) {
    const context = {
      site: {
        title: settings.title,
        description: settings.description,
        footer: settings.footer,
        menuHtml: renderMenuAsHtml(settings.menu),
      },
      post: featured ? {
          title: featured.title,
          description: featured.description,
          content: featured.content, // Home featured content
          pubDate: featured.pubDate,
          category: featured.category,
          tags: featured.tags,
          coverImage: featured.coverImage,
          ...featured.customData
      } : undefined,
      variables: settings.templateVariables,
    };
    const html = renderTemplateVariables(homeFile.content, context);
    return new Response(html, { headers: { 'Content-Type': 'text/html' } });
  }
}

const restPosts = posts.slice(1);
const categorySections = (settings.categories || [])
  .sort((a, b) => (a.sort || 0) - (b.sort || 0))
  .map((cat) => ({
    category: cat,
    posts: posts.filter((post) => (post.category || '').toLowerCase() === cat.slug.toLowerCase()).slice(0, 4),
  }))
  .filter((row) => row.posts.length > 0)
  .slice(0, 6);
---

<SiteLayout title={homeTitle} description={homeDescription}>
  {settings.adSlots?.homeTop && <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-4" set:html={settings.adSlots.homeTop} />}
  <section class="mb-10 overflow-hidden rounded-[2rem] border border-amber-200/60 bg-[linear-gradient(135deg,#fff7ed_0%,#ffffff_50%,#fffbeb_100%)] p-8 shadow-[0_20px_80px_-40px_rgba(245,158,11,0.45)]">
    <div class="grid gap-8 md:grid-cols-[1.2fr_0.8fr] md:items-end">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-amber-600">Cloudflare Pages CMS</p>
        <h1 class="max-w-3xl text-4xl font-black tracking-tight text-slate-950 md:text-6xl">{settings.title}</h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600 md:text-lg">{settings.description}</p>
      </div>
    </div>
  </section>

  {featured && homeTemplate !== 'minimal' && (
    <section class="mb-8 grid gap-6 rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm md:grid-cols-[1.2fr_0.8fr]">
      <a href={`/blog/${featured.slug}`} class="overflow-hidden rounded-[1.5rem]">
        {featured.coverImage ? (
          <img class="h-full max-h-[26rem] w-full rounded-[1.5rem] object-cover" src={featured.coverImage} alt={featured.title} />
        ) : (
          <div class="grid h-full min-h-[20rem] place-items-center rounded-[1.5rem] bg-slate-900 text-slate-100">Featured Story</div>
        )}
      </a>
      <div class="flex flex-col justify-between gap-5">
        <div>
          <div class="mb-3 flex items-center gap-2 text-xs uppercase tracking-[0.24em] text-slate-400">
            {featured.pinned && <span class="rounded-full bg-amber-100 px-2 py-1 text-amber-700">Pinned</span>}
            <span>{new Date(featured.pubDate).toLocaleDateString('zh-CN')}</span>
          </div>
          <a href={`/blog/${featured.slug}`} class="text-3xl font-black tracking-tight text-slate-950">{featured.title}</a>
          <p class="mt-4 text-slate-600">{featured.description}</p>
        </div>
        <div class="flex flex-wrap gap-2 text-xs text-slate-500">
          {featured.tags.map((tag) => <span class="rounded-full bg-slate-100 px-3 py-1">#{tag}</span>)}
        </div>
      </div>
    </section>
  )}

  <section class:list={["grid gap-4", homeTemplate === 'magazine' ? 'md:grid-cols-2' : '', homeTemplate === 'minimal' ? 'gap-3' : 'md:grid-cols-3']}>
    {(homeTemplate === 'minimal' ? posts : restPosts).map((post) => (
      <a href={`/blog/${post.slug}`} class:list={["group rounded-[1.5rem] border border-slate-200 bg-white transition hover:-translate-y-1 hover:shadow-xl", homeTemplate === 'minimal' ? 'p-4' : 'overflow-hidden']}>
        {homeTemplate !== 'minimal' && post.coverImage && (
          <img class="h-48 w-full object-cover transition duration-500 group-hover:scale-[1.03]" src={post.coverImage} alt={post.title} />
        )}
        <div class:list={[homeTemplate === 'minimal' ? '' : 'p-5']}>
          <div class="mb-3 flex items-center gap-2 text-xs uppercase tracking-[0.22em] text-slate-400">
            {post.pinned && <span class="rounded-full bg-amber-100 px-2 py-1 text-amber-700">Pinned</span>}
            {post.category && <span class="rounded-full bg-sky-100 px-2 py-1 text-sky-700">{post.category}</span>}
            <span>{new Date(post.pubDate).toLocaleDateString('zh-CN')}</span>
          </div>
          <h2 class="text-xl font-bold tracking-tight text-slate-950">{post.title}</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">{post.description}</p>
          <div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-500">
            {post.tags.map((tag) => <span class="rounded-full bg-slate-100 px-3 py-1">#{tag}</span>)}
          </div>
        </div>
      </a>
    ))}
  </section>

  {categorySections.length > 0 && (
    <section class="mt-10 grid gap-6">
      {categorySections.map((row) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
          <div class="mb-4 flex items-center justify-between gap-3">
            <div>
              <h3 class="text-xl font-bold text-slate-900">{row.category.name}</h3>
              {row.category.description && <p class="text-sm text-slate-500">{row.category.description}</p>}
            </div>
            <a class="text-sm text-sky-700 hover:text-sky-900" href={`/category/${encodeURIComponent(row.category.slug)}`}>View all</a>
          </div>
          <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
            {row.posts.map((post) => (
              <a href={`/blog/${post.slug}`} class="rounded-xl border border-slate-200 p-3 transition hover:-translate-y-0.5 hover:shadow">
                <h4 class="font-semibold text-slate-900">{post.title}</h4>
                <p class="mt-1 text-sm text-slate-600">{post.description}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>
  )}
</SiteLayout>
