---
import BaseHead from '../components/BaseHead.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const nav = [
  { href: '/admin/overview', label: 'Overview' },
  { href: '/admin/posts', label: 'Articles' },
  { href: '/admin/pages', label: 'Pages' },
  { href: '/admin/templates', label: 'Templates' },
  { href: '/admin/media', label: 'Media' },
  { href: '/admin/ops', label: 'Ops' },
  { href: '/admin/settings', label: 'Settings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={title} />
  </head>
  <body class="min-h-screen bg-[radial-gradient(circle_at_top_left,_#f59e0b_0,_transparent_25%),linear-gradient(180deg,#0f172a_0%,#1e293b_100%)] text-slate-100">
    <div class="grid min-h-screen md:grid-cols-[260px_1fr]">
      <aside class="border-r border-white/10 bg-slate-950/50 p-6 backdrop-blur">
        <a href="/admin/posts" class="mb-8 block text-2xl font-semibold tracking-wide text-amber-300">CloudBlog CMS</a>
        <nav class="grid gap-2">
          {nav.map((item) => (
            <a href={item.href} class="rounded-xl px-4 py-3 text-sm text-slate-200 transition hover:bg-white/10">
              {item.label}
            </a>
          ))}
          <a href="/" class="mt-4 rounded-xl px-4 py-3 text-sm text-slate-400 transition hover:bg-white/10">View Site</a>
        </nav>
      </aside>
      <main class="p-6 md:p-8">
        <div class="mx-auto max-w-6xl">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
