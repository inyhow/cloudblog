---
import BaseHead from '../components/BaseHead.astro';
import { getAuthRole } from '../lib/auth';
import { tr } from '../lib/i18n';
import { getRuntimeEnv } from '../lib/runtime-env';
import { readSettings } from '../lib/settings';

interface Props {
  title: string;
}

const { title } = Astro.props;
const settings = await readSettings(getRuntimeEnv(Astro.locals));
const locale = settings.locale || 'en';
const role = getAuthRole(Astro as any) || 'author';
const allNav = [
  { href: '/admin/overview', label: tr(locale, 'nav.overview', 'Overview') },
  { href: '/admin/posts', label: tr(locale, 'nav.articles', 'Articles') },
  { href: '/admin/pages', label: tr(locale, 'nav.pages', 'Pages') },
  { href: '/admin/templates', label: tr(locale, 'nav.templates', 'Templates') },
  { href: '/admin/media', label: tr(locale, 'nav.media', 'Media') },
  { href: '/admin/settings', label: tr(locale, 'nav.settings', 'Settings') },
];
const nav = allNav.filter((item) => {
  if (role === 'admin') return true;
  if (role === 'editor') return item.href !== '/admin/settings';
  return item.href === '/admin/overview' || item.href === '/admin/posts' || item.href === '/admin/pages' || item.href === '/admin/media';
});
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={title} />
  </head>
  <body class="min-h-screen bg-[radial-gradient(circle_at_top_left,_#f59e0b_0,_transparent_25%),linear-gradient(180deg,#0f172a_0%,#1e293b_100%)] text-slate-100">
    <div class="grid min-h-screen md:grid-cols-[260px_1fr]">
      <aside class="relative z-10 border-r border-white/10 bg-slate-950/50 p-6 backdrop-blur">
        <a href="/admin/posts" class="mb-8 block text-2xl font-semibold tracking-wide text-amber-300">CloudBlog CMS</a>
        <nav class="grid gap-2">
          {nav.map((item) => (
            <a href={item.href} class="rounded-xl px-4 py-3 text-sm text-slate-200 transition hover:bg-white/10">
              {item.label}
            </a>
          ))}
          <a href="/" class="mt-4 rounded-xl px-4 py-3 text-sm text-slate-400 transition hover:bg-white/10">{tr(locale, 'site.viewSite', 'View Site')}</a>
        </nav>
      </aside>
      <main class="relative z-10 p-6 md:p-8">
        <div class="mx-auto max-w-6xl">
          <slot />
        </div>
      </main>
    </div>
    <script is:inline>
      (() => {
        const seen = new WeakSet();

        function isProblemOverlay(el) {
          if (!(el instanceof HTMLElement)) return false;
          const style = window.getComputedStyle(el);
          if (style.position !== 'fixed') return false;
          if (style.pointerEvents === 'none' || style.display === 'none' || style.visibility === 'hidden') return false;
          const opacity = Number.parseFloat(style.opacity || '1');
          if (!Number.isFinite(opacity) || opacity < 0.01) return false;
          const rect = el.getBoundingClientRect();
          const coversViewport =
            rect.width >= window.innerWidth * 0.95 &&
            rect.height >= window.innerHeight * 0.95 &&
            rect.top <= 4 &&
            rect.left <= 4;
          if (!coversViewport) return false;
          const zIndex = Number.parseInt(style.zIndex || '0', 10);
          const hasBackdrop = /(rgba?|hsla?)\(/i.test(style.backgroundColor) && style.backgroundColor !== 'rgba(0, 0, 0, 0)';
          return zIndex >= 20 && hasBackdrop;
        }

        function recoverPage() {
          document.documentElement.style.pointerEvents = 'auto';
          document.body.style.pointerEvents = 'auto';
          document.documentElement.removeAttribute('inert');
          document.body.removeAttribute('inert');
          if ('inert' in document.body) {
            document.body.inert = false;
          }
          document.querySelectorAll('[inert]').forEach((el) => {
            el.inert = false;
            el.removeAttribute('inert');
          });
          document.querySelectorAll('body *').forEach((el) => {
            if (isProblemOverlay(el) && !seen.has(el)) {
              seen.add(el);
              el.style.pointerEvents = 'none';
              el.style.display = 'none';
              el.setAttribute('data-admin-overlay-disabled', 'true');
            }
          });
        }

        recoverPage();
        const observer = new MutationObserver(() => recoverPage());
        observer.observe(document.documentElement, { subtree: true, childList: true, attributes: true, attributeFilter: ['style', 'class', 'inert'] });
        const timer = window.setInterval(recoverPage, 500);
        window.setTimeout(() => {
          observer.disconnect();
          window.clearInterval(timer);
        }, 10000);
      })();
    </script>
  </body>
</html>
