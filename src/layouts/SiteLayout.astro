---
import BaseHead from '../components/BaseHead.astro';
import { readSettings, readThemeCss } from '../lib/settings';
import { getRuntimeEnv } from '../lib/runtime-env';
import { getTemplateFile } from '../lib/template-files';
import { renderTemplateVariables } from '../lib/template-vars';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '' } = Astro.props;
const runtimeEnv = getRuntimeEnv(Astro.locals);
const settings = await readSettings(runtimeEnv);
const themeCss = await readThemeCss(runtimeEnv);
const templateTheme = await getTemplateFile('theme', runtimeEnv);
const googleAnalyticsId = settings.seo?.googleAnalyticsId || '';
const googleSiteVerification = settings.seo?.googleSiteVerification || '';
const googleAdsenseClient = settings.seo?.googleAdsenseClient || '';
const renderedTheme = renderTemplateVariables(templateTheme?.content ?? '', {
  'site.title': settings.title,
  'site.description': settings.description,
  ...settings.templateVariables,
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description || settings.description} />
    <style is:inline>{themeCss}</style>
    <style is:inline>{renderedTheme}</style>
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {
      googleAdsenseClient && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${googleAdsenseClient}`}
          crossOrigin="anonymous"
        />
      )
    }
    {
      googleAnalyticsId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`} />
          <script is:inline>{`window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${googleAnalyticsId}');`}</script>
        </>
      )
    }
  </head>
  <body class="min-h-screen bg-[linear-gradient(180deg,#fff7ed_0%,#ffffff_24%,#f8fafc_100%)] text-slate-800">
    <header class="sticky top-0 z-20 border-b border-slate-200/80 bg-white/85 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl items-center gap-6 px-4 py-4">
        <a class="text-xl font-black tracking-tight text-slate-950" href="/">{settings.title}</a>
        <div class="flex gap-4 text-sm text-slate-600">
          {settings.menu.map((item) => (
            <a class="transition hover:text-slate-950" href={item.href}>{item.label}</a>
          ))}
        </div>
        <a
          href="/admin"
          class="ml-auto rounded-full border border-slate-200 px-3 py-1.5 text-sm text-slate-600 transition hover:border-slate-900 hover:text-slate-900"
        >
          Admin
        </a>
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>
    <footer class="border-t border-slate-200 bg-white/80 py-6 backdrop-blur">
      <div class="mx-auto max-w-6xl px-4 text-sm text-slate-500">{settings.footer}</div>
    </footer>
    {settings.analyticsJs && <script is:inline set:html={settings.analyticsJs} />}
  </body>
</html>
