---
import BaseHead from '../components/BaseHead.astro';
import { readSettings, readThemeCss } from '../lib/settings';
import { getRuntimeEnv } from '../lib/runtime-env';
import { getTemplateFile } from '../lib/template-files';
import { renderTemplateVariables } from '../lib/template-vars';
import { tr } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  variant?: 'classic' | 'imoo';
}

const { title, description = '', variant } = Astro.props;
const runtimeEnv = getRuntimeEnv(Astro.locals);
const settings = await readSettings(runtimeEnv);
const themeCss = await readThemeCss(runtimeEnv);
const templateTheme = await getTemplateFile('theme', runtimeEnv);
const googleAnalyticsId = settings.seo?.googleAnalyticsId || '';
const googleSiteVerification = settings.seo?.googleSiteVerification || '';
const googleAdsenseClient = settings.seo?.googleAdsenseClient || '';
const renderedTheme = renderTemplateVariables(templateTheme?.content ?? '', {
  site: {
    title: settings.title,
    description: settings.description,
    footer: settings.footer,
    menuHtml: '',
  },
  variables: settings.templateVariables,
});
const locale = settings.locale || 'en';
const isSiteWideImoo =
  settings.templates?.home === 'imoo' &&
  settings.templates?.post === 'imoo' &&
  settings.templates?.tag === 'imoo' &&
  settings.templates?.page === 'imoo';
const shellVariant = variant ?? (isSiteWideImoo ? 'imoo' : 'classic');
const isImooShell = shellVariant === 'imoo';
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead title={title} description={description || settings.description} />
    <style is:inline>{themeCss}</style>
    <style is:inline>{renderedTheme}</style>
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {
      googleAdsenseClient && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${googleAdsenseClient}`}
          crossOrigin="anonymous"
        />
      )
    }
    {
      googleAnalyticsId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`} />
          <script is:inline>{`window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${googleAnalyticsId}');`}</script>
        </>
      )
    }
  </head>
  <body class:list={[
    'min-h-screen',
    isImooShell
      ? 'bg-[linear-gradient(180deg,#111827_0%,#0f172a_22%,#e2e8f0_22%,#f8fafc_100%)] text-slate-900'
      : 'bg-[linear-gradient(180deg,#fff7ed_0%,#ffffff_24%,#f8fafc_100%)] text-slate-800',
  ]}>
    <header class:list={[
      'sticky top-0 z-20 border-b backdrop-blur',
      isImooShell
        ? 'border-slate-800/80 bg-slate-950/95 text-white shadow-[0_12px_40px_-24px_rgba(15,23,42,0.9)]'
        : 'border-slate-200/80 bg-white/85',
    ]}>
      <nav class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-4 py-4">
        <a class:list={[
          'font-black tracking-tight',
          isImooShell ? 'text-2xl text-amber-300' : 'text-xl text-slate-950',
        ]} href="/">{settings.title}</a>
        <div class:list={[
          'flex flex-wrap gap-3 text-sm',
          isImooShell ? 'text-slate-300' : 'text-slate-600',
        ]}>
          {settings.menu.map((item) => (
            <a
              class:list={[
                'transition',
                isImooShell
                  ? 'rounded-full border border-white/10 bg-white/5 px-3 py-1.5 hover:border-amber-300/40 hover:text-amber-200'
                  : 'hover:text-slate-950',
              ]}
              href={item.href}
            >
              {item.label}
            </a>
          ))}
        </div>
        <a
          href="/admin"
          class:list={[
            'ml-auto rounded-full px-3 py-1.5 text-sm transition',
            isImooShell
              ? 'border border-amber-300/30 bg-amber-300/10 text-amber-200 hover:bg-amber-300/20'
              : 'border border-slate-200 text-slate-600 hover:border-slate-900 hover:text-slate-900',
          ]}
        >
          {tr(locale, 'site.admin', 'Admin')}
        </a>
      </nav>
    </header>
    <main class:list={[
      'mx-auto px-4 py-10',
      isImooShell ? 'max-w-7xl' : 'max-w-6xl',
    ]}>
      <slot />
    </main>
    <footer class:list={[
      'border-t py-6',
      isImooShell ? 'border-slate-200 bg-white/90' : 'border-slate-200 bg-white/80 backdrop-blur',
    ]}>
      <div class:list={[
        'mx-auto px-4 text-sm',
        isImooShell ? 'max-w-7xl text-slate-500' : 'max-w-6xl text-slate-500',
      ]}>{settings.footer}</div>
    </footer>
    {settings.analyticsJs && <script is:inline set:html={settings.analyticsJs} />}
    <script is:inline>
      (() => {
        // Defensive reset: if page ever enters inert/non-clickable state, recover.
        document.documentElement.style.pointerEvents = 'auto';
        document.body.style.pointerEvents = 'auto';
        if ('inert' in document.body) {
          document.body.inert = false;
        }
        document.querySelectorAll('[inert]').forEach((el) => {
          el.inert = false;
        });
      })();
    </script>
  </body>
</html>
