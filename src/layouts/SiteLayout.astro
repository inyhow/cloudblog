---
import BaseHead from '../components/BaseHead.astro';
import { readSettings, readThemeCss } from '../lib/settings';
import { getRuntimeEnv } from '../lib/runtime-env';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '' } = Astro.props;
const runtimeEnv = getRuntimeEnv(Astro.locals);
const settings = await readSettings(runtimeEnv);
const themeCss = await readThemeCss(runtimeEnv);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description || settings.description} />
    <style is:inline>{themeCss}</style>
  </head>
  <body class="bg-slate-50 text-slate-800">
    <header class="border-b border-slate-200 bg-white">
      <nav class="mx-auto flex max-w-5xl items-center gap-6 px-4 py-4">
        <a class="text-xl font-bold" href="/">{settings.title}</a>
        <div class="flex gap-4 text-sm">
          {settings.menu.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
        <a href="/admin" class="ml-auto text-sm text-slate-500">后台</a>
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-slate-200 bg-white py-6">
      <div class="mx-auto max-w-5xl px-4 text-sm text-slate-500">{settings.footer}</div>
    </footer>
    {settings.analyticsJs && <script is:inline set:html={settings.analyticsJs} />}
  </body>
</html>
