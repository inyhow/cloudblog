---
interface Props {
  title: string;
  description: string;
  content: string;
  customData: Record<string, any>;
}

const { title, description, content, customData = {} } = Astro.props;
const heroImage = customData.heroImage || "https://lh3.googleusercontent.com/aida-public/AB6AXuCYW4cJh8WhlbPBJvPtuuiASCc4geTu6pHrYTopKeU9jpbiOn_IZEhgBikNMfE-22RHcEGON5XxUWuCyNDy_92Wo5QxSfXaqukSpRww4Rz-oOJnnivoN4hSLFkgDHI949QidYiTYYloc956fdJniaKIThI-P5YHyY1jxa_vvRArL_PYbDsARZyrGLqfAaJkjkd184NS1qEzqBgKcdfEFMtmX3fa0RCQ0HJhmoHPIwvphHmIykLbOLDN542JDMYKQ3i4_G21qq1_n2U";
const price = customData.price || "Check on Amazon";
const affiliateLink = customData.affiliateLink || "#";
const heroTitle = customData.heroTitle || title;
const heroDesc = customData.heroDesc || description;
---

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script is:inline>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#f47b25",
                        "background-light": "#f8f7f5",
                        "background-dark": "#221710",
                    },
                    fontFamily: {
                        "display": ["Plus Jakarta Sans"]
                    },
                    borderRadius: {"DEFAULT": "1rem", "lg": "2rem", "xl": "3rem", "full": "9999px"},
                },
            },
        }
    </script>
    <style>
        body { min-height: 100dvh; }
        .prose img { border-radius: 1rem; }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 antialiased">
    <!-- Sticky Navigation -->
    <nav class="sticky top-0 z-50 w-full bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md border-b border-primary/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-3xl">watch_off</span>
                    <span class="text-xl font-extrabold tracking-tight">imoo <span class="text-primary font-normal">Global</span></span>
                </div>
                <div class="hidden md:flex items-center gap-8">
                    <a class="text-sm font-semibold hover:text-primary transition-colors" href="/">Home</a>
                    <a class="text-sm font-semibold hover:text-primary transition-colors" href="#features">Features</a>
                    <a class="text-sm font-semibold hover:text-primary transition-colors" href="/blog">Blog</a>
                </div>
                <div>
                    <a href={affiliateLink} class="bg-primary text-white px-6 py-2 rounded-full font-bold text-sm hover:shadow-lg hover:shadow-primary/30 transition-all inline-block">
                        Buy Now
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-12 pb-20 lg:pt-24 lg:pb-32" id="home">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div class="relative group">
                    <div class="absolute -inset-4 bg-primary/10 rounded-xl blur-2xl group-hover:bg-primary/20 transition-all"></div>
                    <div class="relative bg-white dark:bg-slate-800 p-4 rounded-xl shadow-2xl">
                        <img src={heroImage} alt={title} class="w-full h-auto rounded-lg object-cover aspect-square" />
                    </div>
                </div>
                <div class="space-y-8">
                    <div class="inline-flex items-center gap-2 bg-primary/10 text-primary px-4 py-1.5 rounded-full text-sm font-bold">
                        <span class="material-symbols-outlined text-base">verified</span>
                        Amazon Affiliate Choice 2024
                    </div>
                    <h1 class="text-5xl lg:text-7xl font-extrabold leading-[1.1] tracking-tight text-slate-900 dark:text-white">
                        {heroTitle}
                    </h1>
                    <p class="text-lg text-slate-600 dark:text-slate-400 max-w-xl leading-relaxed">
                        {heroDesc}
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href={affiliateLink} target="_blank" class="flex items-center justify-center gap-2 bg-primary text-white h-14 px-8 rounded-full font-bold text-lg hover:scale-105 transition-transform shadow-xl shadow-primary/20">
                            View Price {price !== "Check on Amazon" ? `(${price})` : "on Amazon"}
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content Section -->
    <section class="py-24 bg-white dark:bg-slate-900">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <article class="prose prose-slate dark:prose-invert max-w-none">
                <div set:html={content} />
            </article>
            
            <div class="flex justify-center mt-16">
                <a href={affiliateLink} target="_blank" class="bg-primary text-white px-10 py-4 rounded-full font-bold text-xl hover:shadow-2xl transition-all shadow-xl shadow-primary/20">
                    Check Availability on Amazon
                </a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="flex items-center gap-2 text-white">
                    <span class="material-symbols-outlined text-primary text-3xl">watch_off</span>
                    <span class="text-xl font-extrabold tracking-tight">imoo <span class="text-primary font-normal">Global</span></span>
                </div>
                <p class="text-xs">
                    © 2024 imoo Affiliate Program. All rights reserved. Amazon and the Amazon logo are trademarks of Amazon.com, Inc. or its affiliates.
                </p>
                <div class="flex gap-6">
                    <a class="hover:text-white" href="#"><span class="material-symbols-outlined">public</span></a>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
